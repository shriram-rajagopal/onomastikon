---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatEra } from '../lib/era';

const civs = await getCollection('civilizations');
const langs = await getCollection('languages');
---

<BaseLayout
  title="Onomastikon"
  schema={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Onomastikon',
    alternateName: 'Onomastikon: A Digital Atlas of Ancient Names',
    url: Astro.site?.href,
    author: { '@type': 'Person', name: 'Shriram Rajagopal' },
    license: 'https://creativecommons.org/licenses/by-sa/4.0/',
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${Astro.site?.href}search?q={search_term_string}`,
      },
      'query-input': 'required name=search_term_string',
    },
  }}
>
  <section class="hero">
    <div class="masthead">
      <video
        class="masthead-motion"
        autoplay
        muted
        playsinline
        poster="/onomastikon-logo.png"
        aria-hidden="true"
      >
        <!-- Transparent (VP9 alpha) for Chromium/Firefox; opaque parchment MP4
             fallback for Safari, which doesn't support WebM alpha. -->
        <source src="/onomastikon-logo.webm" type="video/webm" />
        <source src="/onomastikon-logo.mp4" type="video/mp4" />
      </video>
      <img class="masthead-static" src="/onomastikon-logo.png" alt="Onomastikon" />
    </div>
    <h1>A digital atlas of ancient names</h1>
    <p class="tagline">
      What the great civilizations of antiquity called themselves and what their
      neighbors referred to them as. Original scripts, transliterations, pronunciations,
      and sources.
    </p>
  </section>

  <div class="index-grid">
    <div class="index-col">
      {(() => {
        const grouped = {
          civilization: civs.filter((c) => c.data.type === 'civilization'),
          city: civs.filter((c) => c.data.type === 'city'),
          region: civs.filter((c) => c.data.type === 'region'),
          geographic_feature: civs.filter((c) => c.data.type === 'geographic_feature'),
        };
        const labels = {
          civilization: 'Civilizations',
          city: 'Cities',
          region: 'Regions',
          geographic_feature: 'Geographic features',
        };
        const order = ['civilization', 'city', 'region', 'geographic_feature'] as const;
        return order
          .filter((key) => grouped[key].length > 0)
          .map((key) => (
            <>
              <h2>{labels[key]}</h2>
              <ul class="index-list">
                {grouped[key].map((entity) => (
                  <li>
                    <a href={`/civilizations/${entity.id}`}>
                      <span class="name" data-morph={`civilizations/${entity.id}`}>{entity.data.english_name}</span>
                      <span class="era">{formatEra(entity.data.era_start, entity.data.era_end)}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </>
          ));
      })()}
    </div>

    <div class="index-col">
      <h2>Languages</h2>
      <ul class="index-list">
        {langs.map((lang) => (
          <li>
            <a href={`/languages/${lang.id}`}>
              <span class="name" data-morph={`languages/${lang.id}`}>{lang.data.english_name}</span>
              <span class="era">{lang.data.script}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</BaseLayout>

<style>
  .hero { margin: 1rem 0 3rem; text-align: center; }
  .masthead {
    margin: 0 0 1.5rem;
  }
  /* The video background is the same parchment as the page, so it blends in
     seamlessly. aspect-ratio reserves the space to avoid layout shift. */
  .masthead-motion {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1920 / 720;
    /* The video is transparent; this guarantees an exact-match backdrop. */
    background: var(--parchment);
  }
  /* Static fallback shown only to visitors who prefer reduced motion. */
  .masthead-static {
    display: none;
    width: 100%;
    height: auto;
    aspect-ratio: 1920 / 720;
    background: var(--parchment);
  }
  @media (prefers-reduced-motion: reduce) {
    .masthead-motion { display: none; }
    .masthead-static { display: block; }
  }
  /* The masthead video renders unreliably on mobile WebKit: iOS Safari plays the
     VP9 WebM but ignores its alpha channel, painting the transparent areas black.
     Hide it on any touch device (so both orientations are covered — a landscape
     phone is wider than a width breakpoint) and on narrow windows, showing the
     static wordmark instead. */
  @media (hover: none), (pointer: coarse), (max-width: 640px) {
    .masthead-motion { display: none; }
    .masthead-static { display: block; }
  }
  /* Print the static wordmark, never the video element. */
  @media print {
    .masthead-motion { display: none; }
    .masthead-static { display: block; }
  }
  .tagline {
    font-size: 1.25rem;
    color: var(--ink-soft);
    max-width: 32em;
    /* auto side margins keep the constrained-width tagline centered under
       the centered wordmark and h1. */
    margin: 1rem auto 0;
  }
  /* Entities (left) and Languages (right) sit in parallel columns that both
     begin at the top, so the long Languages list is never buried beneath a
     growing stack of civilizations. Collapses to a single column on phones. */
  .index-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    align-items: start;
  }
  /* A rule centered in the gutter divides entities from languages. The two
     columns each take half the 2.5rem gutter as inner padding, and the border
     sits on the boundary between them. */
  .index-col:first-child { padding-right: 1.25rem; }
  .index-col:last-child {
    padding-left: 1.25rem;
    border-left: 1px solid var(--rule);
  }
  /* Align the two columns' first headings on the same baseline. */
  .index-col > :first-child { margin-top: 0; }
  @media (max-width: 640px) {
    .index-grid { grid-template-columns: 1fr; }
    /* No vertical divider once the columns stack. */
    .index-col:first-child { padding-right: 0; }
    .index-col:last-child { padding-left: 0; border-left: 0; }
  }
  .index-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0 2rem;
  }
  .index-list li { border-bottom: 1px solid var(--rule); }
  .index-list a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.875rem 0;
    text-decoration: none;
    color: var(--ink);
  }
  .index-list a:hover { color: var(--accent); }
  /* min-width:0 lets the name shrink and wrap instead of forcing the row over
     width, which had pushed the script label off the right edge in the narrow
     two-column layout. */
  .name { font-size: 1.125rem; min-width: 0; }
  .era {
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    color: var(--ink-soft);
    /* Keep the script label flush right even when it wraps to two lines. */
    text-align: right;
    flex-shrink: 0;
  }
</style>