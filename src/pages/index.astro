---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatEra } from '../lib/era';
import { MACRO_REGION_OF, MACRO_REGION_LABELS, ERAS } from '../lib/macro-regions';
// The generated endonym subset faces (scripts/subset-endonyms.mjs): the
// languages column renders each self-name in its own script for a few KB.
import '../styles/endonyms.css';

const civs = await getCollection('civilizations');
const langs = await getCollection('languages');

// Region options for the filter row, limited to shelves that actually occur.
const regionOptions = Object.entries(MACRO_REGION_LABELS).filter(([key]) =>
  civs.some((c) => MACRO_REGION_OF[c.id] === key)
);
---

<BaseLayout
  title="Onomastikon"
  description="What the civilizations, cities, regions, and geographic features of antiquity called themselves — and what their neighbors called them. Original scripts, transliterations, pronunciations, and sources for every name."
  schema={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Onomastikon',
    alternateName: 'Onomastikon: A Digital Atlas of Ancient Names',
    description:
      'What the civilizations, cities, regions, and geographic features of antiquity called themselves — and what their neighbors called them.',
    url: Astro.site?.href,
    author: { '@type': 'Person', name: 'Shriram Rajagopal' },
    license: 'https://creativecommons.org/licenses/by-sa/4.0/',
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${Astro.site?.href}search?q={search_term_string}`,
      },
      'query-input': 'required name=search_term_string',
    },
  }}
>
  <nav class="home-toc" aria-label="Contents">
    <span class="home-toc-title">Browse</span>
    <div class="home-toc-cols">
      <div class="home-toc-col">
        <a href="#civilization">Civilizations</a>
        <a href="#city">Cities</a>
        <a href="#region">Regions</a>
        <a href="#geographic_feature">Features</a>
      </div>
      <div class="home-toc-col">
        <a href="#languages">Languages</a>
      </div>
    </div>
  </nav>

  <section class="hero">
    <div class="masthead">
      <!-- Sources are injected by JS only on hover-capable, wide, motion-OK
           viewports: a display:none video with markup sources still downloads
           in most engines, which spent ~130 KB on phones for pixels the CSS
           below never shows. Without JS the poster frame stands in. -->
      <video
        class="masthead-motion"
        autoplay
        muted
        playsinline
        poster="/onomastikon-logo.png"
        aria-hidden="true"
        data-webm="/onomastikon-logo.webm"
        data-mp4="/onomastikon-logo.mp4"
      ></video>
      <img class="masthead-static" src="/onomastikon-logo.webp" alt="Onomastikon" width="1920" height="720" />
    </div>
    <h1>A digital atlas of ancient names</h1>
    <p class="tagline">
      What the civilizations, cities, regions, and geographic features of antiquity
      called themselves — and what their neighbors called them. Original scripts,
      transliterations, pronunciations, and sources.
    </p>
    <!-- Name of the day: filled by JS from the search index at idle (the same
         fetch primes the cache for the search page). Absent without JS; the
         min-height on .hero-daily reserves the line against layout shift. -->
    <p class="hero-daily" id="daily" hidden>
      <span class="daily-label">Name of the day</span>
      <a id="daily-link" href="#"
        ><span id="daily-orig" class="daily-orig"></span>
        <em id="daily-translit"></em></a
      >
      <span id="daily-ctx" class="daily-ctx"></span>
      <span class="daily-sep" aria-hidden="true">·</span>
      <a id="daily-random" href="/search">Random name →</a>
    </p>
  </section>

  <!-- Marks the foot of the hero: the script reveals the Browse rail once this
       scrolls above the viewport. -->
  <div id="hero-sentinel" aria-hidden="true"></div>

  <!-- Region/era filters for the entity index: pure client-side row-hiding
       over data attributes already in the DOM. Hidden until JS removes the
       attribute, so a no-JS visitor sees the plain full index. -->
  <form class="filters" id="filters" hidden aria-label="Filter the index">
    <label>
      <span class="filters-label">Region</span>
      <select id="filter-region">
        <option value="">All regions</option>
        {regionOptions.map(([key, label]) => <option value={key}>{label}</option>)}
      </select>
    </label>
    <label>
      <span class="filters-label">Era</span>
      <select id="filter-era">
        <option value="">All eras</option>
        {ERAS.map((e) => <option value={`${e.start}:${e.end}`}>{e.label}</option>)}
      </select>
    </label>
    <span class="filters-count" id="filters-count" aria-live="polite"></span>
  </form>

  <div class="index-grid">
    <div class="index-col">
      {(() => {
        const byName = (a: typeof civs[number], b: typeof civs[number]) =>
          a.data.english_name.localeCompare(b.data.english_name);
        const grouped = {
          civilization: civs.filter((c) => c.data.type === 'civilization').sort(byName),
          city: civs.filter((c) => c.data.type === 'city').sort(byName),
          region: civs.filter((c) => c.data.type === 'region').sort(byName),
          geographic_feature: civs.filter((c) => c.data.type === 'geographic_feature').sort(byName),
        };
        const labels = {
          civilization: 'Civilizations',
          city: 'Cities',
          region: 'Regions',
          geographic_feature: 'Geographic features',
        };
        const order = ['civilization', 'city', 'region', 'geographic_feature'] as const;
        return order
          .filter((key) => grouped[key].length > 0)
          .map((key) => (
            <section class="index-cat">
              <h2 id={key}>{labels[key]}</h2>
              <ul class="index-list">
                {grouped[key].map((entity) => (
                  <li
                    data-mregion={MACRO_REGION_OF[entity.id]}
                    data-start={entity.data.era_start}
                    data-end={entity.data.era_end ?? 9999}
                  >
                    <a href={`/civilizations/${entity.id}`}>
                      <span class="name" data-morph={`civilizations/${entity.id}`}>{entity.data.english_name}</span>
                      <span class="era">{formatEra(entity.data.era_start, entity.data.era_end)}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ));
      })()}
    </div>

    <div class="index-col">
      <section class="index-cat">
        <h2 id="languages">Languages</h2>
        <ul class="index-list">
          {langs.map((lang) => (
            <li>
              <a href={`/languages/${lang.id}`}>
                <span class="name" data-morph={`languages/${lang.id}`}>{lang.data.english_name}</span>
                {lang.data.native_name ? (
                  <span
                    class="era endonym"
                    lang={lang.data.lang_code}
                    dir={lang.data.direction === 'rtl' ? 'rtl' : undefined}
                    title={lang.data.script}
                  >{lang.data.native_name}</span>
                ) : (
                  <span class="era">{lang.data.script}</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  /* A rough table of contents pinned in the left gutter on wide screens, so a
     reader can jump between the entity categories without scrolling the long
     index. It sits in the empty margin beside the centered 720px column and is
     hidden once the window is too narrow to hold it without overlapping. */
  .home-toc {
    position: fixed;
    top: 7.5rem;
    left: calc((100vw - var(--max-width)) / 2 - 14.5rem);
    width: 13rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    z-index: 5;
    /* Hidden on arrival so it never crowds the masthead and the fading-in
       header; the script reveals it once the hero scrolls past. */
    opacity: 0;
    transform: translateX(-6px);
    pointer-events: none;
  }
  .home-toc.is-visible { opacity: 1; transform: none; pointer-events: auto; }
  @media (prefers-reduced-motion: no-preference) {
    .home-toc { transition: opacity 0.45s ease, transform 0.45s ease; }
  }
  .home-toc-title {
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-size: 0.6875rem;
    color: var(--ink-soft);
  }
  /* Entity categories (left) and Languages (right) sit in parallel columns, the
     same split as the index content below. */
  .home-toc-cols { display: flex; gap: 0.9rem; align-items: start; }
  .home-toc-col { display: flex; flex-direction: column; gap: 0.5rem; min-width: 0; }
  .home-toc-col:first-child { flex: 1 1 auto; }
  .home-toc a {
    white-space: nowrap;
    text-decoration: none;
    color: var(--ink-soft);
    border-left: 2px solid var(--rule);
    padding: 0.1rem 0 0.1rem 0.6rem;
    transition: color 0.12s, border-color 0.12s;
  }
  .home-toc a:hover { color: var(--accent); border-left-color: var(--accent); }
  /* Hide once the gutter can no longer hold the wider two-column rail clear of
     the content. */
  @media (max-width: 1200px) { .home-toc { display: none; } }
  /* Anchor jumps land the heading clear of the top of the viewport. */
  .index-col h2 { scroll-margin-top: 1.5rem; }

  .hero { margin: 1rem 0 3rem; text-align: center; }
  .masthead {
    margin: 0 0 1.5rem;
  }
  /* The video background is the same parchment as the page, so it blends in
     seamlessly. aspect-ratio reserves the space to avoid layout shift. */
  .masthead-motion {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1920 / 720;
    /* The video is transparent; this guarantees an exact-match backdrop. */
    background: var(--parchment);
  }
  /* Static fallback shown only to visitors who prefer reduced motion. */
  .masthead-static {
    display: none;
    width: 100%;
    height: auto;
    aspect-ratio: 1920 / 720;
    background: var(--parchment);
  }
  @media (prefers-reduced-motion: reduce) {
    .masthead-motion { display: none; }
    .masthead-static { display: block; }
  }
  /* The masthead video renders unreliably on mobile WebKit: iOS Safari plays the
     VP9 WebM but ignores its alpha channel, painting the transparent areas black.
     Hide it on any touch device (so both orientations are covered — a landscape
     phone is wider than a width breakpoint) and on narrow windows, showing the
     static wordmark instead. */
  @media (hover: none), (pointer: coarse), (max-width: 640px) {
    .masthead-motion { display: none; }
    .masthead-static { display: block; }
  }
  /* Print the static wordmark, never the video element. */
  @media print {
    .masthead-motion { display: none; }
    .masthead-static { display: block; }
  }
  .tagline {
    font-size: 1.25rem;
    color: var(--ink-soft);
    max-width: 32em;
    /* auto side margins keep the constrained-width tagline centered under
       the centered wordmark and h1. */
    margin: 1rem auto 0;
  }
  /* Name of the day: one quiet line under the tagline. min-height holds the
     row whether or not JS fills it, so the index below never jumps. */
  .hero-daily {
    min-height: 2.2rem;
    margin: 1.5rem auto 0;
    font-size: 1.0625rem;
  }
  .daily-label {
    font-family: 'Inter', sans-serif;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--ink-soft);
    margin-right: 0.5rem;
  }
  .hero-daily a { text-decoration: none; }
  .hero-daily a:hover { text-decoration: underline; }
  /* Original-script text: same per-script font fallbacks as the entry pages. */
  .daily-orig {
    font-family: 'EB Garamond', 'Noto Sans Egyptian Hieroglyphs', 'Noto Sans Cuneiform', 'Noto Sans Old Persian', 'Noto Sans Avestan', 'Noto Serif Devanagari', 'Noto Serif Hebrew', 'Noto Naskh Arabic', 'Noto Sans Coptic', 'Noto Sans Ethiopic', 'Noto Sans Inscriptional Pahlavi', 'Noto Sans Inscriptional Parthian', 'Noto Sans Manichaean', 'Noto Sans Syriac', 'Noto Sans Phoenician', 'Noto Sans Ugaritic', 'Noto Sans Lycian', 'Noto Serif Armenian', 'Noto Sans Old Italic', 'Noto Sans Linear B', serif;
    font-size: 1.25rem;
  }
  .daily-ctx {
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    color: var(--ink-soft);
    margin-left: 0.35rem;
  }
  .daily-sep { color: var(--rule); margin: 0 0.35rem; }
  #daily-random {
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    color: var(--accent);
  }
  /* The heading and tagline settle in a beat after arrival, just behind the
     masthead's own reveal, so the hero reads as "logo, then title" rather than
     everything landing at once. Pure CSS on load (no dependency on the video,
     which the static-image fallbacks don't play); fill-mode `both` holds them
     hidden through the delay so there is no flash. Reduced-motion shows them
     immediately, at rest. */
  @media (prefers-reduced-motion: no-preference) {
    .hero h1 { animation: hero-rise 0.6s ease 0.3s both; }
    .hero .tagline { animation: hero-rise 0.6s ease 0.45s both; }
  }
  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }
  /* Filter row: two quiet selects over the entity index. Styled to sit in the
     page's small-sans register rather than as chrome. */
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1.5rem;
    margin: 0 0 1.5rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
  }
  .filters label { display: flex; align-items: baseline; gap: 0.5rem; }
  .filters-label {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.6875rem;
    color: var(--ink-soft);
  }
  .filters select {
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    color: var(--ink);
    background: var(--parchment);
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 0.25rem 0.4rem;
  }
  .filters-count { color: var(--ink-soft); }

  /* Entities (left) and Languages (right) sit in parallel columns that both
     begin at the top, so the long Languages list is never buried beneath a
     growing stack of civilizations. Collapses to a single column on phones. */
  .index-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    align-items: start;
  }
  /* A rule centered in the gutter divides entities from languages. The two
     columns each take half the 2.5rem gutter as inner padding, and the border
     sits on the boundary between them. */
  .index-col:first-child { padding-right: 1.25rem; }
  .index-col:last-child {
    padding-left: 1.25rem;
    border-left: 1px solid var(--rule);
  }
  /* Align the two columns' first headings on the same baseline. */
  .index-col > .index-cat:first-child h2 { margin-top: 0; }
  /* Index categories fade up as they scroll into view, so the run of names
     below the hero arrives in gentle waves rather than all at once. Opted in
     by JS (the .anim class), so no-JS and reduced-motion show everything. */
  .index-cat.anim { opacity: 0; transform: translateY(16px); }
  .index-cat.anim.revealed { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: no-preference) {
    .index-cat.anim { transition: opacity 0.55s ease, transform 0.55s ease; }
  }
  @media (max-width: 640px) {
    .index-grid { grid-template-columns: 1fr; }
    /* No vertical divider once the columns stack. */
    .index-col:first-child { padding-right: 0; }
    .index-col:last-child { padding-left: 0; border-left: 0; }
  }
  .index-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0 2rem;
  }
  .index-list li { border-bottom: 1px solid var(--rule); }
  .index-list a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.875rem 0;
    text-decoration: none;
    color: var(--ink);
  }
  .index-list a:hover { color: var(--accent); }
  /* min-width:0 lets the name shrink and wrap instead of forcing the row over
     width, which had pushed the script label off the right edge in the narrow
     two-column layout. */
  .name { font-size: 1.125rem; min-width: 0; }
  .era {
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    color: var(--ink-soft);
    /* Keep the script label flush right even when it wraps to two lines. */
    text-align: right;
    flex-shrink: 0;
  }
  /* The language's self-name in its own script — the thesis, demonstrated on
     arrival. 'Endonyms' is the few-KB subset face; the full script fonts
     trail it so an endonym missing from the subset still renders. */
  .endonym {
    font-family: 'Endonyms', 'EB Garamond', 'Noto Sans Egyptian Hieroglyphs', 'Noto Sans Cuneiform', 'Noto Sans Old Persian', 'Noto Sans Avestan', 'Noto Serif Devanagari', 'Noto Serif Hebrew', 'Noto Naskh Arabic', 'Noto Sans Coptic', 'Noto Sans Ethiopic', 'Noto Sans Inscriptional Pahlavi', 'Noto Sans Inscriptional Parthian', 'Noto Sans Manichaean', 'Noto Sans Syriac', 'Noto Sans Phoenician', 'Noto Sans Ugaritic', 'Noto Sans Lycian', 'Noto Serif Armenian', 'Noto Sans Old Italic', 'Noto Sans Linear B', serif;
    font-size: 1.0625rem;
    line-height: 1.3;
  }
</style>

<script>
  // Masthead motion: attach the video sources only where the CSS would show
  // the video at all — hover-capable, fine-pointer, wide, motion-tolerant.
  // Mirrors the media queries below so touch devices and reduced-motion
  // visitors never download a video they'd never see.
  {
    const motion = document.querySelector<HTMLVideoElement>('.masthead-motion');
    const showsMotion =
      matchMedia('(hover: hover) and (pointer: fine) and (min-width: 641px)').matches &&
      !matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (motion && showsMotion) {
      // Transparent (VP9 alpha) for Chromium/Firefox; opaque parchment MP4
      // fallback for Safari, which doesn't support WebM alpha.
      for (const [type, src] of [
        ['video/webm', motion.dataset.webm],
        ['video/mp4', motion.dataset.mp4],
      ]) {
        if (!src) continue;
        const source = document.createElement('source');
        source.type = type!;
        source.src = src;
        motion.append(source);
      }
      motion.load();
    }
  }

  // Name of the day + random entry, from the same static index the search page
  // uses. Fetched at idle so it costs the first paint nothing — and since the
  // response caches, it doubles as a warm-up for /search. Date-hash pick is
  // deterministic for the day; "Random name" re-rolls per click.
  {
    const daily = document.getElementById('daily');
    const namesFrom = (d: Array<Record<string, string>>) => d.filter((r) => r.type === 'name');
    let indexPromise: Promise<Array<Record<string, string>>> | null = null;
    const loadNames = () =>
      (indexPromise ??= fetch('/search-index.json').then((r) => r.json()).then(namesFrom));
    if (daily) {
      // The timeout matters: without it, Chrome can starve idle callbacks
      // indefinitely in background tabs, and the module would never fill in.
      const idle: (cb: () => void) => void =
        'requestIdleCallback' in window
          ? (cb) => requestIdleCallback(cb, { timeout: 1500 })
          : (cb) => setTimeout(cb, 1500);
      idle(() =>
        loadNames().then((names) => {
          if (!names.length) return;
          // FNV-1a over YYYYMMDD: stable for the day, uniform across the corpus.
          const now = new Date();
          const key = `${now.getFullYear()}${now.getMonth() + 1}${now.getDate()}`;
          let h = 2166136261;
          for (const ch of key) {
            h ^= ch.charCodeAt(0);
            h = Math.imul(h, 16777619);
          }
          const pick = names[Math.abs(h) % names.length];
          const link = document.getElementById('daily-link') as HTMLAnchorElement;
          const orig = document.getElementById('daily-orig')!;
          const translit = document.getElementById('daily-translit')!;
          const ctx = document.getElementById('daily-ctx')!;
          link.href = pick.url;
          // label is original script when the entry has one (lang/dir carried
          // in the index), otherwise it already is the transliteration.
          if (pick.translit && pick.label !== pick.translit) {
            orig.textContent = pick.label;
            if (pick.lang) orig.setAttribute('lang', pick.lang);
            if (pick.dir) orig.setAttribute('dir', pick.dir);
            translit.textContent = pick.translit;
          } else {
            translit.textContent = pick.translit || pick.label;
          }
          ctx.textContent = pick.context || '';
          daily.hidden = false;
        })
      );
      document.getElementById('daily-random')?.addEventListener('click', (e) => {
        e.preventDefault();
        loadNames().then((names) => {
          if (!names.length) return;
          location.href = names[Math.floor(Math.random() * names.length)].url;
        });
      });
    }
  }

  // Reveal the Browse rail only once the hero has scrolled up out of the way,
  // so it never appears beside the masthead and the settling header on arrival.
  const toc = document.querySelector('.home-toc');
  const sentinel = document.getElementById('hero-sentinel');
  if (toc && sentinel && 'IntersectionObserver' in window) {
    const railIO = new IntersectionObserver(
      ([e]) => toc.classList.toggle('is-visible', e.boundingClientRect.top < window.innerHeight * 0.25),
      { rootMargin: '-25% 0px 0px 0px', threshold: 0 }
    );
    railIO.observe(sentinel);
  }

  // Region/era filters: hide entity rows that don't match, then hide any
  // category whose rows are all hidden. Languages are untouched. The form is
  // server-rendered hidden and revealed here, so no-JS gets the plain index.
  {
    const form = document.getElementById('filters');
    const regionSel = document.getElementById('filter-region') as HTMLSelectElement | null;
    const eraSel = document.getElementById('filter-era') as HTMLSelectElement | null;
    const count = document.getElementById('filters-count');
    // Entity rows are the ones carrying era data; language rows never match.
    const rows = [...document.querySelectorAll<HTMLLIElement>('.index-list li[data-start]')];
    if (form && regionSel && eraSel && rows.length) {
      form.hidden = false;
      const apply = () => {
        const region = regionSel.value;
        const [eraStart, eraEnd] = eraSel.value ? eraSel.value.split(':').map(Number) : [null, null];
        let shown = 0;
        for (const row of rows) {
          const okRegion = !region || row.dataset.mregion === region;
          const okEra =
            eraStart === null ||
            (Number(row.dataset.start) <= eraEnd! && Number(row.dataset.end) >= eraStart!);
          const on = okRegion && okEra;
          row.hidden = !on;
          if (on) shown++;
        }
        // A category with nothing left to show disappears wholesale.
        for (const cat of document.querySelectorAll<HTMLElement>('.index-col:first-child .index-cat')) {
          cat.hidden = !cat.querySelector('li:not([hidden])');
        }
        const filtering = region || eraStart !== null;
        if (count) count.textContent = filtering ? `${shown} of ${rows.length} shown` : '';
      };
      regionSel.addEventListener('change', apply);
      eraSel.addEventListener('change', apply);
    }
  }

  // Scroll-reveal the index categories: each fades up as it enters view, so the
  // long run of names below the hero arrives in gentle waves. Opted in by JS
  // (the .anim class) so no-JS and reduced-motion visitors see it all at once.
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduceMotion && 'IntersectionObserver' in window) {
    const revealIO = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('revealed');
            revealIO.unobserve(e.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
    );
    for (const cat of document.querySelectorAll('.index-cat')) {
      cat.classList.add('anim');
      revealIO.observe(cat);
    }
  }
</script>