---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HelpTip from '../components/HelpTip.astro';
import { formatEra } from '../lib/era';
import { entryAnchor } from '../lib/entry';
import { MACRO_REGION_OF, MACRO_REGION_LABELS, ERAS } from '../lib/macro-regions';
// The generated endonym subset faces (scripts/subset-endonyms.mjs): the
// languages column renders each self-name in its own script for a few KB.
import '../styles/endonyms.css';
// The committed name-of-the-day ledger (scripts/generate-daily-schedule.mjs):
// picks are frozen once dealt, so corpus growth can't cost anyone their turn.
import dailySchedule from '../data/daily-schedule.json';

const civs = await getCollection('civilizations');
const langs = await getCollection('languages');

// Inline the schedule as indices into the URL-sorted name list (the same
// ordering the client rebuilds from the search index), a fraction of the
// URLs' size. Plain codepoint sort everywhere — collation must not vary.
const names = await getCollection('names');
const nameUrls = names
  .map((n) => `/civilizations/${n.data.civilization.id}#${entryAnchor(n.id, n.data.civilization.id)}`)
  .sort();
const urlIndex = new Map(nameUrls.map((u, i) => [u, i]));
const dailyRounds = dailySchedule.rounds.map((r) => ({
  s: r.start,
  p: r.picks.map((u) => urlIndex.get(u) ?? -1),
}));

// Region options for the filter row, limited to shelves that actually occur.
const regionOptions = Object.entries(MACRO_REGION_LABELS).filter(([key]) =>
  civs.some((c) => MACRO_REGION_OF[c.id] === key)
);

// Entry counts per entity and language, shown as chips in the index so a
// reader can see at a glance which pages are most fleshed out.
const countByCiv = new Map<string, number>();
const countByLang = new Map<string, number>();
for (const n of names) {
  countByCiv.set(n.data.civilization.id, (countByCiv.get(n.data.civilization.id) ?? 0) + 1);
  countByLang.set(n.data.language.id, (countByLang.get(n.data.language.id) ?? 0) + 1);
}

// Long-hover popover data: summary, subheading parts, status, count. The
// minimap is fetched lazily from /locators/<slug>.svg and injected inline so
// the page's theme variables style it.
const popData = Object.fromEntries(
  civs.map((c) => [
    c.id,
    {
      n: c.data.english_name,
      s: c.data.summary,
      r: c.data.region ?? '',
      e: formatEra(c.data.era_start, c.data.era_end),
      st: c.data.entry_status,
      c: countByCiv.get(c.id) ?? 0,
    },
  ])
);
---

<BaseLayout
  title="Onomastikon"
  description="What the civilizations, cities, regions, and geographic features of antiquity called themselves — and what their neighbors called them. Original scripts, transliterations, pronunciations, and sources for every name."
  schema={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Onomastikon',
    alternateName: 'Onomastikon: A Digital Atlas of Ancient Names',
    description:
      'What the civilizations, cities, regions, and geographic features of antiquity called themselves — and what their neighbors called them.',
    url: Astro.site?.href,
    author: { '@type': 'Person', name: 'Shriram Rajagopal' },
    license: 'https://creativecommons.org/licenses/by-sa/4.0/',
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${Astro.site?.href}search?q={search_term_string}`,
      },
      'query-input': 'required name=search_term_string',
    },
  }}
>
  <HelpTip title="Reading this page">
    <p>Two pillars: <strong>entities</strong> (civilizations, cities, regions, features) on the left, the <strong>languages</strong> that named them on the right. Every row is a page.</p>
    <div class="hd-row"><span>Babylon</span><span class="hd-chip hd-green">14</span><span class="hd-era">c. 2300 BCE – 651 CE</span></div>
    <ul>
      <li>The number counts the page's name entries; <span class="hd-chip hd-green">green</span> means coverage is complete, <span class="hd-chip hd-blue">blue</span> still developing.</li>
      <li>Filters combine freely: any set of regions with any set of eras.</li>
      <li>Rest your cursor on an entity row and a panel opens with its summary and a locator map (wide screens).</li>
      <li>The name of the day changes at midnight Eastern; every name gets a turn before any repeats. The ▾ opens the full entry, and “Past names” is the archive.</li>
    </ul>
  </HelpTip>
  <nav class="home-toc" aria-label="Contents">
    <span class="home-toc-title">Browse</span>
    <div class="home-toc-cols">
      <div class="home-toc-col">
        <a href="#civilization">Civilizations</a>
        <a href="#city">Cities</a>
        <a href="#region">Regions</a>
        <a href="#geographic_feature">Features</a>
      </div>
      <div class="home-toc-col">
        <a href="#languages">Languages</a>
      </div>
    </div>
  </nav>

  <section class="hero">
    <div class="masthead">
      <!-- Sources are injected by JS only on hover-capable, wide, motion-OK
           viewports: a display:none video with markup sources still downloads
           in most engines, which spent ~130 KB on phones for pixels the CSS
           below never shows. Without JS the poster frame stands in. -->
      <video
        class="masthead-motion"
        autoplay
        muted
        playsinline
        poster="/onomastikon-logo.png"
        aria-hidden="true"
        data-webm="/onomastikon-logo.webm"
        data-mp4="/onomastikon-logo.mp4"
      ></video>
      <img class="masthead-static" src="/onomastikon-logo.webp" alt="Onomastikon" width="1920" height="720" />
    </div>
    <div class="hero-intro" id="hero-intro">
      <div class="hero-rule" aria-hidden="true"></div>
      <h1>A digital atlas of ancient names</h1>
      <p class="tagline">
        What the civilizations, cities, regions, and geographic features of antiquity
        called themselves — and what their neighbors called them. Original scripts,
        transliterations, pronunciations, and sources.
      </p>
    </div>
  </section>

  <!-- Name of the day: filled by JS from the search index (the same fetch
       primes the cache for the search page). One name per Eastern-time day;
       a per-cycle permutation gives every name one turn before any repeats.
       Absent without JS; the slot's min-height reserves the space. -->
  <div class="daily-slot">
    <section class="daily-card corner-ticks" id="daily" hidden aria-label="Name of the day">
      <span class="daily-legend">Name of the day</span>
      <a id="daily-link" class="daily-link" href="#">
        <span id="daily-orig" class="daily-orig"></span>
        <em id="daily-translit" class="daily-translit"></em>
      </a>
      <p id="daily-meaning" class="daily-meaning" hidden></p>
      <p id="daily-ctx" class="daily-ctx"></p>
      <button id="daily-expand" class="daily-expand" type="button" aria-expanded="false" aria-controls="daily-details" title="Show this entry's details">▾</button>
      <div id="daily-details" class="daily-details" hidden></div>
      <a id="daily-archive" class="daily-archive" href="/names-of-the-day">Past names →</a>
      <a id="daily-random" class="daily-random" href="/search">Random name →</a>
    </section>
  </div>
  <aside id="entity-pop" class="corner-ticks" hidden>
    <h3 id="pop-name"></h3>
    <p class="pop-sub"><span id="pop-region"></span> · <span id="pop-era"></span></p>
    <p class="pop-badges"><span id="pop-status" class="status"></span><span id="pop-count" class="pop-count"></span></p>
    <div id="pop-map" class="pop-map" aria-hidden="true"></div>
    <p id="pop-summary" class="pop-summary"></p>
  </aside>
  <script type="application/json" id="entity-pop-data" set:html={JSON.stringify(popData)} />
  <script type="application/json" id="daily-schedule" set:html={JSON.stringify(dailyRounds)} />

  <!-- Marks the foot of the hero: the script reveals the Browse rail once this
       scrolls above the viewport. -->
  <div id="hero-sentinel" aria-hidden="true"></div>

  <!-- Region/era filters for the entity index: pure client-side row-hiding
       over data attributes already in the DOM. Hidden until JS removes the
       attribute, so a no-JS visitor sees the plain full index. -->
  <form class="filters" id="filters" hidden aria-label="Filter the index">
    <fieldset class="filter-group" id="filter-region">
      <legend class="filters-label">Region</legend>
      {regionOptions.map(([key, label]) => (
        <button type="button" class="chip" data-value={key} aria-pressed="false">{label}</button>
      ))}
    </fieldset>
    <fieldset class="filter-group" id="filter-era">
      <legend class="filters-label">Era</legend>
      {ERAS.map((e) => (
        <button type="button" class="chip" data-value={`${e.start}:${e.end}`} aria-pressed="false" title={e.label}>{e.label.split(' (')[0]}</button>
      ))}
    </fieldset>
    <span class="filters-count" id="filters-count" aria-live="polite"></span>
  </form>

  <div class="index-grid">
    <div class="index-col corner-ticks">
      {(() => {
        const byName = (a: typeof civs[number], b: typeof civs[number]) =>
          a.data.english_name.localeCompare(b.data.english_name);
        const grouped = {
          civilization: civs.filter((c) => c.data.type === 'civilization').sort(byName),
          city: civs.filter((c) => c.data.type === 'city').sort(byName),
          region: civs.filter((c) => c.data.type === 'region').sort(byName),
          geographic_feature: civs.filter((c) => c.data.type === 'geographic_feature').sort(byName),
        };
        const labels = {
          civilization: 'Civilizations',
          city: 'Cities',
          region: 'Regions',
          geographic_feature: 'Geographic features',
        };
        const order = ['civilization', 'city', 'region', 'geographic_feature'] as const;
        return order
          .filter((key) => grouped[key].length > 0)
          .map((key) => (
            <section class="index-cat">
              <h2 id={key}>{labels[key]}</h2>
              <ul class="index-list">
                {grouped[key].map((entity) => (
                  <li
                    data-slug={entity.id}
                    data-mregion={MACRO_REGION_OF[entity.id]}
                    data-start={entity.data.era_start}
                    data-end={entity.data.era_end ?? 9999}
                  >
                    <a href={`/civilizations/${entity.id}`}>
                      <span class="name" data-morph={`civilizations/${entity.id}`}>{entity.data.english_name}</span>
                      <span class="row-meta">
                        <span class={`count count-${entity.data.entry_status}`} title={`${countByCiv.get(entity.id) ?? 0} name entries (${entity.data.entry_status})`}>{countByCiv.get(entity.id) ?? 0}</span>
                        <span class="era">{formatEra(entity.data.era_start, entity.data.era_end)}</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ));
      })()}
    </div>

    <div class="index-col corner-ticks">
      <section class="index-cat">
        <h2 id="languages">Languages</h2>
        <ul class="index-list">
          {langs.map((lang) => (
            <li>
              <a href={`/languages/${lang.id}`}>
                <span class="name" data-morph={`languages/${lang.id}`}>{lang.data.english_name}</span>
                <span class="row-meta">
                  <span class="count count-language" title={`${countByLang.get(lang.id) ?? 0} name entries`}>{countByLang.get(lang.id) ?? 0}</span>
                  {lang.data.native_name ? (
                    <span
                      class="era endonym"
                      lang={lang.data.lang_code}
                      dir={lang.data.direction === 'rtl' ? 'rtl' : undefined}
                      title={lang.data.script}
                    >{lang.data.native_name}</span>
                  ) : (
                    <span class="era">{lang.data.script}</span>
                  )}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  /* A rough table of contents pinned in the left gutter on wide screens, so a
     reader can jump between the entity categories without scrolling the long
     index. It sits in the empty margin beside the centered 720px column and is
     hidden once the window is too narrow to hold it without overlapping. */
  .home-toc {
    position: fixed;
    top: 7.5rem;
    left: calc((100vw - var(--max-width)) / 2 - 14.5rem);
    width: 13rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    z-index: 5;
    /* Hidden on arrival so it never crowds the masthead and the fading-in
       header; the script reveals it once the hero scrolls past. */
    opacity: 0;
    transform: translateX(-6px);
    pointer-events: none;
  }
  .home-toc.is-visible { opacity: 1; transform: none; pointer-events: auto; }
  @media (prefers-reduced-motion: no-preference) {
    .home-toc { transition: opacity 0.45s ease, transform 0.45s ease; }
  }
  .home-toc-title {
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-size: 0.6875rem;
    color: var(--ink-soft);
  }
  /* Entity categories (left) and Languages (right) sit in parallel columns, the
     same split as the index content below. */
  .home-toc-cols { display: flex; gap: 0.9rem; align-items: start; }
  .home-toc-col { display: flex; flex-direction: column; gap: 0.5rem; min-width: 0; }
  .home-toc-col:first-child { flex: 1 1 auto; }
  .home-toc a {
    white-space: nowrap;
    text-decoration: none;
    color: var(--ink-soft);
    border-left: 2px solid var(--rule-strong);
    padding: 0.1rem 0 0.1rem 0.6rem;
    transition: color 0.12s, border-color 0.12s;
  }
  /* Each rail link wears its section's lozenge and, on hover, its color —
     the same palette as the headings and chips it points at. */
  .home-toc a::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 0.45rem;
    transform: rotate(45deg);
    background: var(--accent);
  }
  .home-toc a[href='#city']::before { background: var(--badge-developing-fg); }
  .home-toc a[href='#region']::before { background: var(--conf-attested-fg); }
  .home-toc a[href='#geographic_feature']::before { background: var(--conf-reconstructed-fg); }
  .home-toc a[href='#languages']::before { background: var(--conf-disputed-fg); }
  .home-toc a:hover { color: var(--accent); border-left-color: var(--accent); }
  .home-toc a[href='#city']:hover { color: var(--badge-developing-fg); border-left-color: var(--badge-developing-fg); }
  .home-toc a[href='#region']:hover { color: var(--conf-attested-fg); border-left-color: var(--conf-attested-fg); }
  .home-toc a[href='#geographic_feature']:hover { color: var(--conf-reconstructed-fg); border-left-color: var(--conf-reconstructed-fg); }
  .home-toc a[href='#languages']:hover { color: var(--conf-disputed-fg); border-left-color: var(--conf-disputed-fg); }
  /* Hide once the gutter can no longer hold the wider two-column rail clear of
     the content. */
  @media (max-width: 1200px) { .home-toc { display: none; } }
  /* Anchor jumps land the heading clear of the top of the viewport. */
  .index-col h2 { scroll-margin-top: 1.5rem; }

  .hero { margin: 1rem 0 3rem; text-align: center; }
  .masthead {
    margin: 0 0 1.5rem;
  }
  /* The video background is the same parchment as the page, so it blends in
     seamlessly. aspect-ratio reserves the space to avoid layout shift. */
  .masthead-motion {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1920 / 720;
    /* The video is transparent; this guarantees an exact-match backdrop. */
    background: var(--parchment);
  }
  /* Static fallback shown only to visitors who prefer reduced motion. */
  .masthead-static {
    display: none;
    width: 100%;
    height: auto;
    aspect-ratio: 1920 / 720;
    background: var(--parchment);
  }
  @media (prefers-reduced-motion: reduce) {
    .masthead-motion { display: none; }
    .masthead-static { display: block; }
  }
  /* The masthead video renders unreliably on mobile WebKit: iOS Safari plays the
     VP9 WebM but ignores its alpha channel, painting the transparent areas black.
     Hide it on any touch device (so both orientations are covered — a landscape
     phone is wider than a width breakpoint) and on narrow windows, showing the
     static wordmark instead. */
  @media (hover: none), (pointer: coarse), (max-width: 640px) {
    .masthead-motion { display: none; }
    .masthead-static { display: block; }
  }
  /* Print the static wordmark, never the video element. */
  @media print {
    .masthead-motion { display: none; }
    .masthead-static { display: block; }
  }
  .tagline {
    font-size: 1.25rem;
    color: var(--ink-soft);
    max-width: 32em;
    /* auto side margins keep the constrained-width tagline centered under
       the centered wordmark and h1. */
    margin: 1rem auto 0;
  }
  /* Name of the day: a legend-framed plate between the hero and the index —
     hairline rule box with the label set into the top border and the random
     link set into the bottom, both on parchment cutouts. The slot's
     min-height reserves the space so the index doesn't jump when JS fills
     the card in (or never does). */
  .daily-slot { min-height: 15rem; margin: 0 0 2.5rem; }
  .daily-card {
    position: relative;
    border: 1px solid var(--rule-strong);
    border-radius: 6px;
    background-image: var(--grain);
    box-shadow: var(--shadow-soft);
    padding: 2.5rem 1.5rem 2rem;
    text-align: center;
  }
  .daily-legend {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    background: var(--parchment);
    padding: 0 0.8rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
    white-space: nowrap;
  }
  .daily-link { display: block; text-decoration: none; color: var(--ink); }
  .daily-link:hover .daily-translit { color: var(--accent); }
  /* Original-script text: same per-script font fallbacks as the entry pages. */
  .daily-orig {
    display: block;
    font-family: 'EB Garamond', 'Noto Sans Egyptian Hieroglyphs', 'Noto Sans Cuneiform', 'Noto Sans Old Persian', 'Noto Sans Avestan', 'Noto Serif Devanagari', 'Noto Serif Hebrew', 'Noto Naskh Arabic', 'Noto Sans Coptic', 'Noto Sans Ethiopic', 'Noto Sans Inscriptional Pahlavi', 'Noto Sans Inscriptional Parthian', 'Noto Sans Manichaean', 'Noto Sans Syriac', 'Noto Sans Phoenician', 'Noto Sans Ugaritic', 'Noto Sans Lycian', 'Noto Serif Armenian', 'Noto Sans Old Italic', 'Noto Sans Linear B', 'Noto Sans Brahmi', 'Noto Sans Old Sogdian', serif;
    font-size: 3rem;
    line-height: 1.15;
  }
  .daily-translit {
    display: block;
    font-size: 1.375rem;
    margin-top: 0.35rem;
    transition: color 0.12s;
  }
  .daily-meaning {
    font-style: italic;
    font-size: 1.0625rem;
    color: var(--ink-soft);
    margin: 0.75rem 0 0;
  }
  .daily-ctx {
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    margin: 0.9rem 0 0;
  }
  .daily-random {
    position: absolute;
    bottom: 0;
    right: 1.5rem;
    transform: translateY(50%);
    background: var(--parchment);
    padding: 0 0.6rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    color: var(--accent);
    text-decoration: none;
  }
  .daily-random:hover { text-decoration: underline; }
  /* The archive link mirrors the random link on the opposite corner. */
  .daily-archive {
    position: absolute;
    bottom: 0;
    left: 1.5rem;
    transform: translateY(50%);
    background: var(--parchment);
    padding: 0 0.6rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    color: var(--accent);
    text-decoration: none;
  }
  .daily-archive:hover { text-decoration: underline; }
  /* The expander arrow pops down the full entry details in place. */
  .daily-expand {
    display: block;
    margin: 0.6rem auto 0;
    padding: 0 0.7rem;
    background: none;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    color: var(--accent);
    font-size: 0.8rem;
    line-height: 1.7;
    cursor: pointer;
    box-shadow: var(--shadow-soft);
  }
  .daily-expand:hover { border-color: var(--accent); }
  @media (prefers-reduced-motion: no-preference) {
    .daily-expand { transition: transform 0.2s ease; }
  }
  .daily-expand.open { transform: rotate(180deg); }
  .daily-details {
    max-width: 30rem;
    margin: 0.8rem auto 0;
    padding-top: 0.8rem;
    border-top: 1px solid var(--rule);
    text-align: left;
    font-size: 0.9375rem;
    overflow: hidden;
  }
  @media (prefers-reduced-motion: no-preference) {
    .daily-details { animation: daily-unfold 0.28s ease; }
  }
  @keyframes daily-unfold {
    from { opacity: 0; transform: translateY(-6px); }
  }
  /* The detail nodes are created at runtime, so they carry no scoped-style
     attribute; anchor on the static container and reach them with :global. */
  #daily-details :global(dl) { display: grid; grid-template-columns: max-content 1fr; gap: 0.25rem 1.2rem; margin: 0; }
  #daily-details :global(dt) {
    font-family: 'Inter', sans-serif;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    padding-top: 0.15rem;
  }
  #daily-details :global(dd) { margin: 0; }
  #daily-details :global(.conf) {
    font-family: 'Inter', sans-serif;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.1rem 0.45rem;
    border-radius: 3px;
  }
  #daily-details :global(.conf-attested) { background: var(--conf-attested-bg); color: var(--conf-attested-fg); }
  #daily-details :global(.conf-reconstructed) { background: var(--conf-reconstructed-bg); color: var(--conf-reconstructed-fg); }
  #daily-details :global(.conf-disputed) { background: var(--conf-disputed-bg); color: var(--conf-disputed-fg); }
  #daily-details :global(.dd-link),
  #daily-details :global(.dn-link) { display: inline-block; margin-top: 0.7rem; font-family: 'Inter', sans-serif; font-size: 0.8125rem; }
  #daily-details :global(.dn-prose) { font-size: 0.9375rem; line-height: 1.6; margin-bottom: 0.9rem; }
  #daily-details :global(.dn-prose p:first-child) { margin-top: 0; }
  #daily-details :global(.dn-sources) { margin: 0; padding-left: 1.1rem; }
  #daily-details :global(.dn-sources li) { margin: 0.2rem 0; }
  /* The intro sequence: the wordmark lands, a rule draws itself beneath it,
     and the title and tagline shoot up into the line from below. Fill-mode
     `both` holds everything hidden through its delay; reduced-motion shows
     the finished state immediately. */
  .hero-rule {
    width: min(26rem, 72%);
    height: 2px;
    margin: 0.3rem auto 0.9rem;
    background: var(--accent);
    transform-origin: center;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-rule { animation: hero-rule-draw 0.7s ease 0.45s both; }
    .hero-intro h1 { animation: hero-shoot 0.65s cubic-bezier(0.2, 0.7, 0.2, 1) 1.05s both; }
    .hero-intro .tagline { animation: hero-shoot 0.65s cubic-bezier(0.2, 0.7, 0.2, 1) 1.22s both; }
  }
  @keyframes hero-rule-draw {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
  @keyframes hero-shoot {
    from { opacity: 0; transform: translateY(46px) scale(0.98); }
    to { opacity: 1; transform: none; }
  }
  /* Seen once, the intro folds away for the rest of the visit: scrolling back
     up shows the wordmark alone; only a reload (or the header wordmark, which
     is one) brings the title back. */
  .hero-intro { overflow: hidden; max-height: 24rem; }
  @media (prefers-reduced-motion: no-preference) {
    .hero-intro { transition: max-height 0.6s ease, opacity 0.45s ease, margin 0.6s ease; }
  }
  .hero-intro.folded { max-height: 0; opacity: 0; margin: 0; }
  /* Filter row: two quiet selects over the entity index. Styled to sit in the
     page's small-sans register rather than as chrome. */
  .filters {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin: 0 0 1.5rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    /* The filters govern the entity pillar only, so they sit flush over it:
       same width as the left column of the grid below. */
    width: calc(50% - 0.75rem);
  }
  @media (max-width: 640px) {
    .filters { width: 100%; }
  }
  .filters label { display: flex; align-items: baseline; gap: 0.5rem; }
  .filters-label {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.6875rem;
    color: var(--ink-soft);
  }
  .filter-group { border: 0; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; }
  .filter-group legend { float: left; margin-right: 0.2rem; padding: 0; }
  .chip {
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem;
    color: var(--ink-soft);
    background: var(--parchment);
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    padding: 0.15rem 0.7rem;
    cursor: pointer;
    box-shadow: var(--shadow-soft);
  }
  @media (prefers-reduced-motion: no-preference) {
    .chip { transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease; }
  }
  .chip:hover { border-color: var(--accent); color: var(--accent); }
  .chip[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--parchment);
  }
  .filters-count { color: var(--ink-soft); }

  /* Entities (left) and Languages (right) sit in parallel columns that both
     begin at the top, so the long Languages list is never buried beneath a
     growing stack of civilizations. Collapses to a single column on phones. */
  .index-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    align-items: start;
  }
  /* Each column is a defined panel: strong rule, soft shadow, faint paper
     grain, corner ticks (class in markup). */
  .index-col {
    border: 1px solid var(--rule-strong);
    border-radius: 6px;
    background-color: color-mix(in srgb, var(--ink) 2%, var(--parchment));
    background-image: var(--grain);
    box-shadow: var(--shadow-soft);
    padding: 0 1.25rem 1rem;
  }
  /* Align the two columns' first headings on the same baseline. */
  .index-col > .index-cat:first-child h2 { margin-top: 0; }
  /* Index categories fade up as they scroll into view, so the run of names
     below the hero arrives in gentle waves rather than all at once. Opted in
     by JS (the .anim class), so no-JS and reduced-motion show everything. */
  .index-cat.anim { opacity: 0; transform: translateY(16px); }
  .index-cat.anim.revealed { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: no-preference) {
    .index-cat.anim { transition: opacity 0.55s ease, transform 0.55s ease; }
  }
  @media (max-width: 640px) {
    .index-grid { grid-template-columns: 1fr; }
  }
  .index-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0 2rem;
  }
  .index-list li { border-bottom: 1px solid var(--rule); }
  .index-list li:last-child { border-bottom: 0; }
  .index-list a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.875rem 0.4rem;
    margin: 0 -0.4rem;
    border-left: 3px solid transparent;
    text-decoration: none;
    color: var(--ink);
  }
  /* Hover emphasis: the row under the cursor grows and lights; because the
     padding animates, rows swelling and settling as the cursor rides a
     scrolling list is the intended effect. */
  @media (prefers-reduced-motion: no-preference) {
    .index-list a { transition: background 0.16s ease, padding 0.2s ease, border-color 0.16s ease; }
  }
  .index-list a:hover, .index-list a:focus-visible {
    color: var(--accent);
    border-left-color: var(--accent);
    background: linear-gradient(90deg, color-mix(in srgb, var(--accent) 10%, transparent), transparent 80%);
    padding-top: 1.05rem;
    padding-bottom: 1.05rem;
    padding-left: 0.7rem;
  }
  .row-meta { display: flex; align-items: baseline; gap: 0.55rem; flex-shrink: 0; }
  /* Entry-count chips, tinted by entity type: the page's color variation is
     drawn from the existing badge palette so both themes are already tuned. */
  .count {
    font-family: 'Inter', sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.5;
    padding: 0 0.5rem;
    border-radius: 999px;
  }
  /* Entity chips are colored by entry status, so the count and the badge on
     the entity page agree: green = complete, blue = still developing. */
  .count-complete { background: var(--badge-complete-bg); color: var(--badge-complete-fg); }
  .count-developing { background: var(--badge-developing-bg); color: var(--badge-developing-fg); }
  .count-language { background: var(--conf-disputed-bg); color: var(--conf-disputed-fg); }
  /* Section headings wear their section color in the text itself, matching
     the lozenge beside them. */
  #civilization { color: var(--accent); }
  #city { color: var(--badge-developing-fg); }
  #region { color: var(--conf-attested-fg); }
  #geographic_feature { color: var(--conf-reconstructed-fg); }
  #languages { color: var(--conf-disputed-fg); }
  /* Globe for the entity sections, scroll for languages, seated on the rule
     where the hedera sits elsewhere. Theme-tinted via the icon variables. */
  #civilization::after, #city::after, #region::after, #geographic_feature::after {
    content: var(--icon-globe);
  }
  #languages::after { content: var(--icon-scroll); }
  .index-cat h2::before {
    content: '';
    display: inline-block;
    width: 9px;
    height: 9px;
    margin-right: 0.55rem;
    transform: rotate(45deg);
    background: var(--accent);
  }
  #city::before { background: var(--badge-developing-fg); }
  #region::before { background: var(--conf-attested-fg); }
  #geographic_feature::before { background: var(--conf-reconstructed-fg); }
  #languages::before { background: var(--conf-disputed-fg); }

  /* Long-hover popover: a lifted panel in the right gutter with the entity's
     summary, minimap, subheading, status, and count. Fixed-position, filled
     and revealed by script; wide hover-capable screens only. */
  #entity-pop {
    position: fixed;
    left: calc(50% + 380px);
    width: 300px;
    z-index: 30;
    background-color: color-mix(in srgb, var(--ink) 2%, var(--parchment));
    background-image: var(--grain);
    border: 1px solid var(--rule-strong);
    border-radius: 6px;
    padding: 1rem 1.15rem 1.1rem;
    box-shadow: var(--shadow-lift);
    opacity: 0;
    transform: translateX(-10px);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    #entity-pop { transition: opacity 0.22s ease, transform 0.22s ease; }
  }
  #entity-pop.show { opacity: 1; transform: none; pointer-events: auto; }
  #entity-pop h3 { margin: 0; font-size: 1.25rem; }
  .pop-sub { font-family: 'Inter', sans-serif; font-size: 0.75rem; color: var(--ink-soft); margin: 0.25rem 0 0.5rem; }
  .pop-badges { display: flex; align-items: center; gap: 0.6rem; margin: 0 0 0.6rem; }
  #entity-pop .status {
    font-family: 'Inter', sans-serif;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
  }
  #entity-pop .status-developing { background: var(--badge-developing-bg); color: var(--badge-developing-fg); }
  #entity-pop .status-complete { background: var(--badge-complete-bg); color: var(--badge-complete-fg); }
  .pop-count { font-family: 'Inter', sans-serif; font-size: 0.75rem; color: var(--ink-soft); }
  .pop-map { margin: 0 0 0.6rem; }
  .pop-summary { font-size: 0.9375rem; line-height: 1.55; margin: 0; color: var(--ink); }
  @media (max-width: 1439px), (hover: none) {
    #entity-pop { display: none; }
  }
  /* min-width:0 lets the name shrink and wrap instead of forcing the row over
     width, which had pushed the script label off the right edge in the narrow
     two-column layout. */
  .name { font-size: 1.125rem; min-width: 0; }
  .era {
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    color: var(--ink-soft);
    /* Keep the script label flush right even when it wraps to two lines. */
    text-align: right;
    flex-shrink: 0;
  }
  /* The language's self-name in its own script — the thesis, demonstrated on
     arrival. 'Endonyms' is the few-KB subset face; the full script fonts
     trail it so an endonym missing from the subset still renders. */
  .endonym {
    font-family: 'Endonyms', 'EB Garamond', 'Noto Sans Egyptian Hieroglyphs', 'Noto Sans Cuneiform', 'Noto Sans Old Persian', 'Noto Sans Avestan', 'Noto Serif Devanagari', 'Noto Serif Hebrew', 'Noto Naskh Arabic', 'Noto Sans Coptic', 'Noto Sans Ethiopic', 'Noto Sans Inscriptional Pahlavi', 'Noto Sans Inscriptional Parthian', 'Noto Sans Manichaean', 'Noto Sans Syriac', 'Noto Sans Phoenician', 'Noto Sans Ugaritic', 'Noto Sans Lycian', 'Noto Serif Armenian', 'Noto Sans Old Italic', 'Noto Sans Linear B', 'Noto Sans Brahmi', 'Noto Sans Old Sogdian', serif;
    font-size: 1.0625rem;
    line-height: 1.3;
  }
</style>

<script>
  // Masthead motion: attach the video sources only where the CSS would show
  // the video at all — hover-capable, fine-pointer, wide, motion-tolerant.
  // Mirrors the media queries below so touch devices and reduced-motion
  // visitors never download a video they'd never see.
  {
    const motion = document.querySelector<HTMLVideoElement>('.masthead-motion');
    const showsMotion =
      matchMedia('(hover: hover) and (pointer: fine) and (min-width: 641px)').matches &&
      !matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (motion && showsMotion) {
      // Transparent (VP9 alpha) for Chromium/Firefox; opaque parchment MP4
      // fallback for Safari, which doesn't support WebM alpha.
      for (const [type, src] of [
        ['video/webm', motion.dataset.webm],
        ['video/mp4', motion.dataset.mp4],
      ]) {
        if (!src) continue;
        const source = document.createElement('source');
        source.type = type!;
        source.src = src;
        motion.append(source);
      }
      motion.load();
    }
  }

  // Name of the day + random entry, from the same static index the search page
  // uses. Fetched at idle so it costs the first paint nothing — and since the
  // response caches, it doubles as a warm-up for /search. Date-hash pick is
  // deterministic for the day; "Random name" re-rolls per click.
  {
    const daily = document.getElementById('daily');
    const namesFrom = (d: Array<Record<string, string>>) => d.filter((r) => r.type === 'name');
    let indexPromise: Promise<Array<Record<string, string>>> | null = null;
    const loadNames = () =>
      (indexPromise ??= fetch('/search-index.json').then((r) => r.json()).then(namesFrom));
    if (daily) {
      // The timeout matters: without it, Chrome can starve idle callbacks
      // indefinitely in background tabs, and the module would never fill in.
      const idle: (cb: () => void) => void =
        'requestIdleCallback' in window
          ? (cb) => requestIdleCallback(cb, { timeout: 1500 })
          : (cb) => setTimeout(cb, 1500);
      idle(() =>
        loadNames().then((names) => {
          if (!names.length) return;
          // The day rolls at midnight US Eastern: format today's date in
          // America/New_York (DST handled by the zone data) and convert it
          // to a running day count.
          const nyDate = new Intl.DateTimeFormat('en-CA', {
            timeZone: 'America/New_York',
          }).format(new Date());
          const [y, m, d] = nyDate.split('-').map(Number);
          const day = Math.floor(Date.UTC(y, m - 1, d) / 86400000);

          // Every name gets one turn before any gets a second, and the
          // guarantee survives corpus growth: today's pick comes from the
          // committed schedule ledger (inlined as indices into the URL-sorted
          // list), whose dealt days are frozen at build time — new names are
          // only ever inserted into undealt days. See
          // scripts/generate-daily-schedule.mjs for the dealing rules.
          // Plain codepoint sort, matching the ledger and the inliner. The
          // deck stays the FULL name list — schedule indices point into it —
          // while eligibility (original script present; the index carries
          // lang only for original-script labels) gates the fallback and the
          // random link, mirroring the generator's pool rule.
          const deck = [...names].sort((a, b) => (a.url < b.url ? -1 : a.url > b.url ? 1 : 0));
          const eligible = deck.filter((r) => r.lang);
          const N = eligible.length;
          let pick: (typeof deck)[number] | undefined;
          try {
            const rounds: Array<{ s: number; p: number[] }> = JSON.parse(
              document.getElementById('daily-schedule')?.textContent ?? '[]'
            );
            const round = rounds.find((r) => r.s <= day && day < r.s + r.p.length);
            if (round) pick = deck[round.p[day - round.s]];
          } catch {}
          // Fallback for days beyond the schedule horizon (a site left
          // undeployed for over a year): the old per-cycle permutation.
          if (!pick) {
            const mulberry32 = (seed: number) => () => {
              seed |= 0;
              seed = (seed + 0x6d2b79f5) | 0;
              let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
              t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
              return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
            };
            const rand = mulberry32(Math.floor(day / N) + N * 0x9e3779b1);
            for (let i = N - 1; i > 0; i--) {
              const k = Math.floor(rand() * (i + 1));
              [eligible[i], eligible[k]] = [eligible[k], eligible[i]];
            }
            pick = eligible[day % N];
          }
          if (!pick) return;

          const link = document.getElementById('daily-link') as HTMLAnchorElement;
          const orig = document.getElementById('daily-orig')!;
          const translit = document.getElementById('daily-translit')!;
          const meaning = document.getElementById('daily-meaning')!;
          const ctx = document.getElementById('daily-ctx')!;
          link.href = pick.url;
          // label is original script when the entry has one (lang/dir carried
          // in the index), otherwise it already is the transliteration.
          if (pick.translit && pick.label !== pick.translit) {
            orig.textContent = pick.label;
            if (pick.lang) orig.setAttribute('lang', pick.lang);
            if (pick.dir) orig.setAttribute('dir', pick.dir);
            translit.textContent = pick.translit;
          } else {
            orig.hidden = true;
            translit.textContent = pick.translit || pick.label;
          }
          if (pick.meaning) {
            meaning.textContent = `“${pick.meaning}”`;
            meaning.hidden = false;
          }
          ctx.textContent = pick.context || '';
          daily.dataset.url = pick.url;
          daily.dataset.day = String(day);
          daily.hidden = false;
        })
      );
      // The expander arrow pops down the full entry: the archive page renders
      // every day's card with prose and details server-side, so the homepage
      // fetches it once and clones today's details block. One source of
      // truth; the prose, dl, badges, and sources arrive ready-made.
      const expandBtn = document.getElementById('daily-expand');
      const detailsEl = document.getElementById('daily-details');
      let archivePromise: Promise<Document> | null = null;
      const loadArchive = () =>
        (archivePromise ??= fetch('/names-of-the-day')
          .then((r) => r.text())
          .then((t) => new DOMParser().parseFromString(t, 'text/html')));
      expandBtn?.addEventListener('click', async () => {
        const open = !detailsEl!.hidden;
        if (open) {
          detailsEl!.hidden = true;
          expandBtn.classList.remove('open');
          expandBtn.setAttribute('aria-expanded', 'false');
          return;
        }
        detailsEl!.textContent = '';
        const doc = await loadArchive();
        const src = doc.querySelector(`.dn-card[data-day="${daily.dataset.day}"] .dn-details`);
        if (src) {
          const node = document.importNode(src, true) as HTMLElement;
          node.hidden = false;
          node.removeAttribute('class');
          detailsEl!.append(...node.childNodes);
        } else {
          const a = document.createElement('a');
          a.className = 'dd-link';
          a.href = daily.dataset.url ?? '/';
          a.textContent = 'Read the full entry →';
          detailsEl!.append(a);
        }
        detailsEl!.hidden = false;
        expandBtn.classList.add('open');
        expandBtn.setAttribute('aria-expanded', 'true');
      });

      document.getElementById('daily-random')?.addEventListener('click', (e) => {
        e.preventDefault();
        loadNames().then((names) => {
          // Same eligibility as the daily pick: original script only.
          const pool = names.filter((r) => r.lang);
          if (!pool.length) return;
          location.href = pool[Math.floor(Math.random() * pool.length)].url;
        });
      });
    }
  }

  // Long-hover popover: rest the cursor on an entity row for a beat and a
  // panel slides out beside the index with the entry's summary, minimap,
  // subheading, and status. Wide hover-capable screens only; the minimap SVG
  // is fetched once per entity and injected inline so theme variables apply.
  {
    const pop = document.getElementById('entity-pop');
    const wants = matchMedia('(min-width: 1440px) and (hover: hover)').matches;
    if (pop && wants) {
      const data = JSON.parse(document.getElementById('entity-pop-data')!.textContent!);
      const mapCache = new Map<string, string>();
      const el = (id: string) => document.getElementById(id)!;
      let showTimer = 0;
      let hideTimer = 0;
      let shownFor: string | null = null;

      const hide = () => {
        pop.classList.remove('show');
        shownFor = null;
        // Keep it in the tree for the exit transition, then drop it.
        window.setTimeout(() => { if (!shownFor) pop.hidden = true; }, 240);
      };

      const show = async (slug: string, row: HTMLElement) => {
        const d = data[slug];
        if (!d) return;
        el('pop-name').textContent = d.n;
        el('pop-region').textContent = d.r;
        el('pop-era').textContent = d.e;
        const status = el('pop-status');
        status.textContent = d.st;
        status.className = `status status-${d.st}`;
        el('pop-count').textContent = `${d.c} name ${d.c === 1 ? 'entry' : 'entries'}`;
        el('pop-summary').textContent = d.s;
        const holder = el('pop-map');
        holder.innerHTML = '';
        if (!mapCache.has(slug)) {
          try {
            const r = await fetch(`/locators/${slug}.svg`);
            mapCache.set(slug, r.ok ? await r.text() : '');
          } catch {
            mapCache.set(slug, '');
          }
        }
        holder.innerHTML = mapCache.get(slug) ?? '';
        // Align to the hovered row, clamped inside the viewport.
        pop.hidden = false;
        const rect = row.getBoundingClientRect();
        const top = Math.min(Math.max(rect.top - 8, 76), innerHeight - pop.offsetHeight - 16);
        pop.style.top = `${top}px`;
        shownFor = slug;
        requestAnimationFrame(() => pop.classList.add('show'));
      };

      for (const li of document.querySelectorAll<HTMLElement>('.index-list li[data-slug]')) {
        li.addEventListener('mouseenter', () => {
          window.clearTimeout(showTimer);
          window.clearTimeout(hideTimer);
          showTimer = window.setTimeout(() => show(li.dataset.slug!, li), 550);
        });
        li.addEventListener('mouseleave', () => {
          window.clearTimeout(showTimer);
          hideTimer = window.setTimeout(hide, 180);
        });
      }
      // Let the reader mouse into the panel (to read the summary) without it
      // vanishing under them.
      pop.addEventListener('mouseenter', () => window.clearTimeout(hideTimer));
      pop.addEventListener('mouseleave', () => { hideTimer = window.setTimeout(hide, 180); });
      addEventListener('scroll', () => { if (shownFor) hide(); }, { passive: true });
    }
  }

  // Reveal the Browse rail only once the hero has scrolled up out of the way,
  // so it never appears beside the masthead and the settling header on arrival.
  const toc = document.querySelector('.home-toc');
  const sentinel = document.getElementById('hero-sentinel');
  const intro = document.getElementById('hero-intro');
  let introFolded = false;
  if (sentinel && 'IntersectionObserver' in window) {
    const railIO = new IntersectionObserver(
      ([e]) => {
        const past = e.boundingClientRect.top < window.innerHeight * 0.25;
        toc?.classList.toggle('is-visible', past);
        // First full pass over the hero folds the intro away for the rest of
        // the visit; the wordmark stands alone from here on.
        if (past && intro && !introFolded) {
          introFolded = true;
          intro.classList.add('folded');
        }
      },
      { rootMargin: '-25% 0px 0px 0px', threshold: 0 }
    );
    railIO.observe(sentinel);
  }

  // Region/era filters: hide entity rows that don't match, then hide any
  // category whose rows are all hidden. Languages are untouched. The form is
  // server-rendered hidden and revealed here, so no-JS gets the plain index.
  {
    const form = document.getElementById('filters');
    const count = document.getElementById('filters-count');
    // Entity rows are the ones carrying era data; language rows never match.
    const rows = [...document.querySelectorAll<HTMLLIElement>('.index-list li[data-start]')];
    if (form && rows.length) {
      form.hidden = false;
      // Multi-select: chips toggle in and out of each set. Within a dimension
      // the selections union (Mesopotamia OR South Asia); across dimensions
      // they intersect (in those regions AND overlapping a chosen era). An
      // empty set means the dimension is unfiltered.
      const regions = new Set<string>();
      const eras = new Set<string>();
      const apply = () => {
        let shown = 0;
        for (const row of rows) {
          const okRegion = regions.size === 0 || regions.has(row.dataset.mregion ?? '');
          const okEra =
            eras.size === 0 ||
            [...eras].some((v) => {
              const [lo, hi] = v.split(':').map(Number);
              return Number(row.dataset.start) <= hi && Number(row.dataset.end) >= lo;
            });
          const on = okRegion && okEra;
          row.hidden = !on;
          if (on) shown++;
        }
        // A category with nothing left to show disappears wholesale.
        for (const cat of document.querySelectorAll<HTMLElement>('.index-col:first-child .index-cat')) {
          cat.hidden = !cat.querySelector('li:not([hidden])');
        }
        if (count) count.textContent = regions.size || eras.size ? `${shown} of ${rows.length} shown` : '';
      };
      const wire = (groupId: string, set: Set<string>) => {
        document.getElementById(groupId)?.addEventListener('click', (e) => {
          const chip = (e.target as Element).closest<HTMLButtonElement>('.chip');
          if (!chip) return;
          const v = chip.dataset.value!;
          const on = !set.has(v);
          set[on ? 'add' : 'delete'](v);
          chip.setAttribute('aria-pressed', String(on));
          apply();
        });
      };
      wire('filter-region', regions);
      wire('filter-era', eras);
    }
  }

  // Scroll-reveal the index categories: each fades up as it enters view, so the
  // long run of names below the hero arrives in gentle waves. Opted in by JS
  // (the .anim class) so no-JS and reduced-motion visitors see it all at once.
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduceMotion && 'IntersectionObserver' in window) {
    const revealIO = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('revealed');
            revealIO.unobserve(e.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
    );
    for (const cat of document.querySelectorAll('.index-cat')) {
      cat.classList.add('anim');
      revealIO.observe(cat);
    }
  }
</script>