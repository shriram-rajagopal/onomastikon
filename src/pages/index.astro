---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const civs = await getCollection('civilizations');
const langs = await getCollection('languages');

function formatEra(start: number, end: number) {
  const fmt = (y: number) => (y < 0 ? `${Math.abs(y)} BCE` : `${y} CE`);
  return `c. ${fmt(start)} – ${fmt(end)}`;
}
---

<BaseLayout title="Onomastikon">
  <section class="hero">
    <div class="masthead">
      <video
        class="masthead-motion"
        autoplay
        muted
        playsinline
        poster="/onomastikon-logo.png"
        aria-hidden="true"
      >
        <!-- Transparent (VP9 alpha) for Chromium/Firefox; opaque parchment MP4
             fallback for Safari, which doesn't support WebM alpha. -->
        <source src="/onomastikon-logo.webm" type="video/webm" />
        <source src="/onomastikon-logo.mp4" type="video/mp4" />
      </video>
      <img class="masthead-static" src="/onomastikon-logo.png" alt="Onomastikon" />
    </div>
    <h1>A digital atlas of ancient names</h1>
    <p class="tagline">
      What the great civilizations of antiquity called themselves and what their
      neighbors referred to them as. Original scripts, transliterations, pronunciations,
      and sources.
    </p>
  </section>

  {(() => {
    const grouped = {
      civilization: civs.filter((c) => c.data.type === 'civilization'),
      city: civs.filter((c) => c.data.type === 'city'),
      region: civs.filter((c) => c.data.type === 'region'),
      geographic_feature: civs.filter((c) => c.data.type === 'geographic_feature'),
    };
    const labels = {
      civilization: 'Civilizations',
      city: 'Cities',
      region: 'Regions',
      geographic_feature: 'Geographic features',
    };
    const order = ['civilization', 'city', 'region', 'geographic_feature'] as const;
    return order
      .filter((key) => grouped[key].length > 0)
      .map((key) => (
        <>
          <h2>{labels[key]}</h2>
          <ul class="index-list">
            {grouped[key].map((entity) => (
              <li>
                <a href={`/civilizations/${entity.id}`}>
                  <span class="name">{entity.data.english_name}</span>
                  <span class="era">{formatEra(entity.data.era_start, entity.data.era_end)}</span>
                </a>
              </li>
            ))}
          </ul>
        </>
      ));
  })()}

  <h2>Languages</h2>
  <ul class="index-list">
    {langs.map((lang) => (
      <li>
        <a href={`/languages/${lang.id}`}>
          <span class="name">{lang.data.english_name}</span>
          <span class="era">{lang.data.script}</span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .hero { margin: 1rem 0 3rem; }
  .masthead {
    margin: 0 0 1.5rem;
  }
  /* The video background is the same parchment as the page, so it blends in
     seamlessly. aspect-ratio reserves the space to avoid layout shift. */
  .masthead-motion {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1920 / 720;
    /* The video is transparent; this guarantees an exact-match backdrop. */
    background: var(--parchment);
  }
  /* Static fallback shown only to visitors who prefer reduced motion. */
  .masthead-static {
    display: none;
    width: 100%;
    height: auto;
    aspect-ratio: 1920 / 720;
    background: var(--parchment);
  }
  @media (prefers-reduced-motion: reduce) {
    .masthead-motion { display: none; }
    .masthead-static { display: block; }
  }
  .tagline {
    font-size: 1.25rem;
    color: var(--ink-soft);
    max-width: 32em;
    margin-top: 1rem;
  }
  .index-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0 2rem;
  }
  .index-list li { border-bottom: 1px solid var(--rule); }
  .index-list a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.875rem 0;
    text-decoration: none;
    color: var(--ink);
  }
  .index-list a:hover { color: var(--accent); }
  .name { font-size: 1.125rem; }
  .era {
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }
</style>