---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const civs = await getCollection('civilizations');
const langs = await getCollection('languages');

function formatEra(start: number, end: number) {
  const fmt = (y: number) => (y < 0 ? `${Math.abs(y)} BCE` : `${y} CE`);
  return `${fmt(start)} – ${fmt(end)}`;
}
---

<BaseLayout title="Onomastikon">
  <section class="hero">
    <p class="eyebrow">Onomastikon</p>
    <h1>A digital atlas of ancient names</h1>
    <p class="tagline">
      What the great civilizations of antiquity called themselves and what their
      neighbors referred to them as. Original scripts, transliterations, pronunciations,
      and sources.
    </p>
  </section>

  <h2>Civilizations</h2>
  <ul class="index-list">
    {civs.map((civ) => (
      <li>
        <a href={`/civilizations/${civ.id}`}>
          <span class="name">{civ.data.english_name}</span>
          <span class="era">{formatEra(civ.data.era_start, civ.data.era_end)}</span>
        </a>
      </li>
    ))}
  </ul>

  <h2>Languages</h2>
  <ul class="index-list">
    {langs.map((lang) => (
      <li>
        <a href={`/languages/${lang.id}`}>
          <span class="name">{lang.data.english_name}</span>
          <span class="era">{lang.data.script}</span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .hero { margin: 1rem 0 3rem; }
  .eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--ink-soft);
    margin: 0 0 0.5rem;
  }
  .tagline {
    font-size: 1.25rem;
    color: var(--ink-soft);
    max-width: 32em;
    margin-top: 1rem;
  }
  .index-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0 2rem;
  }
  .index-list li { border-bottom: 1px solid var(--rule); }
  .index-list a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.875rem 0;
    text-decoration: none;
    color: var(--ink);
  }
  .index-list a:hover { color: var(--accent); }
  .name { font-size: 1.125rem; }
  .era {
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }
</style>