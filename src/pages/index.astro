---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HelpTip from '../components/HelpTip.astro';
import { formatEra } from '../lib/era';
import { entryAnchor } from '../lib/entry';
import { latestModified } from '../lib/dates';
import { MACRO_REGION_OF, MACRO_REGION_LABELS, ERAS } from '../lib/macro-regions';
// The generated endonym subset faces (scripts/subset-endonyms.mjs): the
// languages column renders each self-name in its own script for a few KB.
import '../styles/endonyms.css';
// The committed name-of-the-day ledger (scripts/generate-daily-schedule.mjs):
// picks are frozen once dealt, so corpus growth can't cost anyone their turn.
import dailySchedule from '../data/daily-schedule.json';

const civs = await getCollection('civilizations');
const langs = await getCollection('languages');

// Inline the schedule as indices into the URL-sorted name list (the same
// ordering the client rebuilds from the search index), a fraction of the
// URLs' size. Plain codepoint sort everywhere — collation must not vary.
const names = await getCollection('names');
const nameUrls = names
  .map((n) => `/civilizations/${n.data.civilization.id}#${entryAnchor(n.id, n.data.civilization.id)}`)
  .sort();
const urlIndex = new Map(nameUrls.map((u, i) => [u, i]));
const dailyRounds = dailySchedule.rounds.map((r) => ({
  s: r.start,
  p: r.picks.map((u) => urlIndex.get(u) ?? -1),
}));

// Region options for the filter row, limited to shelves that actually occur.
const regionOptions = Object.entries(MACRO_REGION_LABELS).filter(([key]) =>
  civs.some((c) => MACRO_REGION_OF[c.id] === key)
);

// Entry counts per entity and language, shown as chips in the index so a
// reader can see at a glance which pages are most fleshed out.
const countByCiv = new Map<string, number>();
const countByLang = new Map<string, number>();
for (const n of names) {
  countByCiv.set(n.data.civilization.id, (countByCiv.get(n.data.civilization.id) ?? 0) + 1);
  countByLang.set(n.data.language.id, (countByLang.get(n.data.language.id) ?? 0) + 1);
}

// Long-hover popover data: summary, subheading parts, status, count. The
// minimap is fetched lazily from /locators/<slug>.svg and injected inline so
// the page's theme variables style it.
const popData = Object.fromEntries(
  civs.map((c) => [
    c.id,
    {
      n: c.data.english_name,
      s: c.data.summary,
      r: c.data.region ?? '',
      e: formatEra(c.data.era_start, c.data.era_end),
      st: c.data.entry_status,
      c: countByCiv.get(c.id) ?? 0,
    },
  ])
);

// The five ages written out: clicking a period name above the timeline opens
// a short portrait of the age. Entity mentions link to their entries and
// carry the same hover popover as the index rows.
const L = (slug: string, text: string) =>
  `<a class="ent-link" data-slug="${slug}" href="/civilizations/${slug}">${text}</a>`;
const ERA_NOTES: Record<string, { span: string; html: string }> = {
  bronze: {
    span: 'c. 3500–1200 BCE',
    html: `<p>The age of the first cities and the first writing. Along the ${L('nile', 'Nile')}, the ${L('tigris', 'Tigris')}, and the ${L('euphrates', 'Euphrates')}, irrigation farming fed the first urban societies: ${L('sumer', 'Sumer')}, where ${L('uruk', 'Uruk')} grew into a city of tens of thousands; ${L('egypt', 'Egypt')} under its god-kings; the ${L('indus', 'Indus')} cities that Mesopotamian ledgers call ${L('meluhha', 'Meluhha')}. Nearly everyone farmed. Money did not yet exist, so palace and temple ran the economy, collecting grain, wool, and labor and paying them back out as rations; kingship was a sacred office, answerable to the gods for canal and harvest, and ${L('akkad', 'Akkad')} stretched that kingship into the first empire.</p><p>Bronze itself explains the age's reach: copper from ${L('magan', 'Magan')} and tin from far mountains had to travel, so routes ran the ${L('persian-gulf', 'Persian Gulf')} through ${L('dilmun', 'Dilmun')}, and ships wove ${L('minoan-crete', 'Minoan Crete')}, the ${L('aegean', 'Aegean')}, and ${L('mycenae', 'Mycenae')} into the eastern trade. The great courts of Egypt, the ${L('hittites', 'Hittites')}, ${L('babylonia', 'Babylonia')}, and ${L('assyria', 'Assyria')} exchanged letters, brides, and gifts in a first international system, and fought with the age's prestige weapon, the horse-drawn chariot. Cuneiform and hieroglyphic scribes kept the records; temple festivals kept the calendar. Around 1200 BCE the whole network burned down in a collapse remembered ever after in the legend of ${L('troy', 'Troy')}.</p>`,
  },
  iron: {
    span: 'c. 1200–550 BCE',
    html: `<p>Iron remade life from below. Ore was common where copper and tin were rare, so metal tools and weapons reached ordinary farmers and soldiers, and villages cleared land the Bronze Age never touched. The alphabet, carried by the merchants of ${L('phoenicia', 'Phoenicia')} out of ${L('tyre', 'Tyre')} and ${L('sidon', 'Sidon')}, did for writing what iron did for metal and took literacy out of the scribal schools. In the space the fallen empires left grew small kingdoms with strong identities: ${L('israel', 'Israel')} and ${L('judah', 'Judah')}, Aramaean ${L('damascus', 'Damascus')}, ${L('phrygia', 'Phrygia')} and ${L('lydia', 'Lydia')} in ${L('anatolia', 'Anatolia')}, where the first coins were struck. ${L('carthage', 'Carthage')} and the city-states of ${L('greece', 'Greece')} planted colonies from ${L('sicily', 'Sicily')} to the ${L('black-sea', 'Black Sea')}, and the sea became a single marketplace of oil, wine, grain, and slaves.</p><p>The age's superpower was ${L('assyria', 'Assyria')}: professional armies, siege engineering, imperial roads, mass deportations, and at ${L('nineveh', 'Nineveh')} a royal library that tried to hold all knowledge. ${L('babylonia', 'Babylonia')} and ${L('media', 'Media')} divided its empire between them. On the steppe, ${L('scythia', 'Scythia')} and the ${L('cimmerians', 'Cimmerians')} made the mounted archer the new fact of war. Worldviews sharpened with the borders: the prophets of Judah preached one God over all nations, ${L('iran', 'Iran')}'s seers framed the world as a war of truth against the lie, and the Greeks wrote Homer down. Iron, alphabet, and coin were the kit every later empire picked up.</p>`,
  },
  classical: {
    span: 'c. 550–30 BCE',
    html: `<p>${L('persia', 'Persia')} joined the world into its first superstate, satrapies from the ${L('nile', 'Nile')} to the ${L('indus', 'Indus')} bound by royal roads, standard coin, and a chancellery that proclaimed the king's peace in three languages from ${L('persepolis', 'Persepolis')} and ${L('susa', 'Susa')}. Against it the small cities of ${L('greece', 'Greece')} defined a rival ideal: the armed citizen, the public assembly, and in ${L('athens', 'Athens')} drama, history, and philosophy as civic arts, with ${L('sparta', 'Sparta')} as the severe counter-model. ${L('macedon', 'Macedon')} fused the two worlds when Alexander took the Persian empire whole, and the successor kingdoms made Greek the language of power from ${L('alexandria', 'Alexandria')} to ${L('bactria', 'Bactria')}.</p><p>Coined money now paid soldiers, taxed harvests, and moved grain across the ${L('mediterranean', 'Mediterranean')}, while slave-worked estates and mines concentrated wealth as never before. In ${L('india', 'India')} the Mauryas ruled from ${L('pataliputra', 'Pataliputra')} and sent Buddhist teaching through ${L('taxila', 'Taxila')} toward the mountain passes; in ${L('china', 'China')} the warring kingdoms hammered themselves into one state that would outlast them all. Armies were the age's laboratories: phalanx, war elephant, siege engine, and, as ${L('rome', 'Rome')} and ${L('carthage', 'Carthage')} fought for the west at ${L('syracuse', 'Syracuse')} and beyond, the legion. Civic temples still anchored public life, but mystery cults, Buddhism, and the philosophical schools now offered individuals a destiny of their own.</p>`,
  },
  late: {
    span: 'c. 30 BCE–600 CE',
    html: `<p>${L('rome', 'Rome')} ringed the ${L('mediterranean', 'Mediterranean')} and called it "our sea": one law and coinage, roads, aqueducts, and cities with baths and theaters from ${L('italia', 'Italia')} to ${L('syria', 'Syria')}. Most people still farmed, but they farmed inside a single market; the grain of ${L('egypt', 'Egypt')} fed the capital, and oil and wine crossed the sea in bulk. Professional legions held a walled frontier for centuries against ${L('parthia', 'Parthia')} and then Sasanian ${L('iran', 'Iran')}, the rival superpower that never fell. Beyond the empires, caravans through ${L('sogdiana', 'Sogdiana')} and ${L('bactria', 'Bactria')} and monsoon fleets out of the ${L('red-sea', 'Red Sea')} tied Rome to ${L('india', 'India')} and Han ${L('china', 'China')}; silk moved west, silver east, and the world was more connected than it would be again for a thousand years.</p><p>The deepest change was religious. Christianity spread from ${L('jerusalem', 'Jerusalem')} through the cities into the state itself; Zoroastrianism ordered Iran; Buddhism rode the caravan roads into China. Law was codified, and learning gathered at ${L('alexandria', 'Alexandria')}. From the late fourth century, steppe migrations and plague broke the western provinces into successor kingdoms, but the east held: Constantine's new capital at ${L('byzantium', 'Byzantium')} carried the empire on, and its Greek-speaking citizens went on calling themselves Romans for another thousand years.</p>`,
  },
  medieval: {
    span: 'c. 600–1453 CE',
    html: `<p>Islam rose in Arabia, and within a century the caliphs, ruling first from ${L('damascus', 'Damascus')}, governed from the western ${L('mediterranean', 'Mediterranean')} to the ${L('oxus', 'Oxus')}. Theirs was the hub economy of the age: gold coin and paper credit, dhows riding the monsoon from the ${L('red-sea', 'Red Sea')} and the ${L('persian-gulf', 'Persian Gulf')} to ${L('india', 'India')} and beyond, caravans through ${L('sogdiana', 'Sogdiana')} to Tang ${L('china', 'China')}. Western Europe contracted to the manor, peasants owing labor to armored lords in a pyramid of oaths, while ${L('byzantium', 'Byzantium')} held the Roman line under its old name. Faith organized everything: mosque, church, and monastery served as school, archive, bank, and court at once, and ${L('jerusalem', 'Jerusalem')} drew pilgrims and crusaders of three faiths.</p><p>Steppe power redrew the map twice, first through the Turks, then through the Mongols, whose empire briefly joined China to the ${L('black-sea', 'Black Sea')} in one commercial world under a single passport. Along those roads technology moved west: paper, the compass, gunpowder. Europe raised windmills, heavy plows, cathedrals, and universities, and recovered Greek philosophy through Arabic translation. In 1453 Ottoman guns breached the Theodosian walls, Constantinople fell, and the age this atlas covers closes where naming began: with an ancient city under a new name.</p>`,
  },
};
---

<BaseLayout
  title="Onomastikon"
  description="Naming the civilizations, cities, regions, and geographic features of the ancient and medieval worlds, from the Bronze Age to the fall of Constantinople. Telling their story, with English translations and transliterations. Interactive maps and diagrams, all rigorously sourced."
  schema={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Onomastikon',
    alternateName: 'Onomastikon: A Digital Atlas of Ancient Names',
    description:
      'Naming the civilizations, cities, regions, and geographic features of the ancient and medieval worlds, from the Bronze Age to the fall of Constantinople. Telling their story, with English translations and transliterations. Interactive maps and diagrams, all rigorously sourced.',
    url: Astro.site?.href,
    author: { '@type': 'Person', name: 'Shriram Rajagopal' },
    license: 'https://creativecommons.org/licenses/by-sa/4.0/',
    ...(latestModified && { dateModified: latestModified }),
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${Astro.site?.href}search?q={search_term_string}`,
      },
      'query-input': 'required name=search_term_string',
    },
  }}
>
  <HelpTip title="Reading this page" callout>
    <p>Two pillars: <strong>entities</strong> (civilizations, cities, regions, features) on the left, the <strong>languages</strong> that named them on the right. Every row is a page.</p>
    <div class="hd-row"><span>Babylon</span><span class="hd-chip hd-green">14</span><span class="hd-era">c. 2300 BCE – 651 CE</span></div>
    <ul>
      <li>The number counts the page's name entries; <span class="hd-chip hd-green">green</span> means coverage is complete, <span class="hd-chip hd-blue">blue</span> still developing.</li>
      <li>Region chips filter the index; picking an era name above the timeline filters to that age and opens a short portrait of it, with links into the atlas.</li>
      <li>Rest your cursor on an entity row and a panel opens with its summary and a locator map (wide screens).</li>
      <li>The name of the day changes at midnight Eastern; every name gets a turn before any repeats. The ▾ opens the full entry, and “Past names” is the archive.</li>
    </ul>
  </HelpTip>
  <nav class="home-toc" aria-label="Contents">
    <span class="home-toc-title">Browse</span>
    <div class="home-toc-cols">
      <div class="home-toc-col">
        <a href="#civilization">Civilizations</a>
        <a href="#city">Cities</a>
        <a href="#region">Regions</a>
        <a href="#geographic_feature">Features</a>
      </div>
      <div class="home-toc-col">
        <a href="#languages">Languages</a>
      </div>
    </div>
  </nav>

  <section class="hero">
    <!-- The wordmark as live text: letters pop in sequence, the sigma in the
         accent, and the accent rule below is the wordmark's underline — it
         draws itself and stays after the intro text dissolves behind it. -->
    <p class="masthead-word" aria-label="Onomastikon">
      {['O','N','O','M','A','Σ','T','I','K','O','N'].map((ch, i) => (
        <span class={ch === 'Σ' ? 'letter letter-sigma' : 'letter'} style={`--i: ${i}`} aria-hidden="true">{ch}</span>
      ))}
    </p>
    <div class="hero-rule" aria-hidden="true"></div>
    <div class="hero-intro" id="hero-intro">
      <div class="hero-clip">
        <div class="hero-intro-inner">
          <h1>A digital atlas of ancient and medieval names</h1>
          <p class="tagline">
            <em>Onomastikon</em>, Greek for “a list of names”: what the civilizations, cities, and
            rivers of the ancient and medieval worlds called themselves, and what their neighbors
            called them, from the Bronze Age to the fall of Constantinople. Told with English
            translations, interactive maps and diagrams, all rigorously sourced.
          </p>
        </div>
      </div>
    </div>
    {/* Outside #hero-intro on purpose: the intro flies up on first scroll and
        the search box must not leave with it. */}
    <form class="hero-search" action="/search" role="search">
      <input
        type="search"
        name="q"
        placeholder="Search a name or place: Kemet, Babylon, the Nile…"
        aria-label="Search the atlas"
        autocomplete="off"
      />
      <button type="submit">Search</button>
    </form>
  </section>

  <!-- Name of the day: filled by JS from the search index (the same fetch
       primes the cache for the search page). One name per Eastern-time day;
       a per-cycle permutation gives every name one turn before any repeats.
       Absent without JS; the slot's min-height reserves the space. -->
  <div class="daily-slot">
    <section class="daily-card corner-ticks" id="daily" hidden aria-label="Name of the day">
      <span class="daily-legend">Name of the day</span>
      <a id="daily-link" class="daily-link" href="#">
        <span id="daily-orig" class="daily-orig"></span>
        <em id="daily-translit" class="daily-translit"></em>
      </a>
      <p id="daily-meaning" class="daily-meaning" hidden></p>
      <p id="daily-ctx" class="daily-ctx"></p>
      <button id="daily-expand" class="daily-expand" type="button" aria-expanded="false" aria-controls="daily-details" title="Show this entry's details">▾</button>
      <div id="daily-details" class="daily-details" hidden></div>
      <a id="daily-archive" class="daily-archive" href="/names-of-the-day">Past names →</a>
      <a id="daily-random" class="daily-random" href="/search">Random name →</a>
      <button id="daily-share" class="daily-share" type="button" title="Copy a link to this name">Share ↗</button>
    </section>
  </div>
  {/* The name is a styled paragraph, not a heading: the element is empty
      until the script fills it, and an empty heading fails WCAG. */}
  <aside id="entity-pop" class="corner-ticks" aria-live="polite" hidden>
    <p class="pop-name" id="pop-name"></p>
    <p class="pop-sub"><span id="pop-region"></span> · <span id="pop-era"></span></p>
    <p class="pop-badges"><span id="pop-status" class="status"></span><span id="pop-count" class="pop-count"></span></p>
    <div id="pop-map" class="pop-map" aria-hidden="true"></div>
    <p id="pop-summary" class="pop-summary"></p>
  </aside>
  <script type="application/json" id="entity-pop-data" set:html={JSON.stringify(popData)} />
  <script type="application/json" id="daily-schedule" set:html={JSON.stringify(dailyRounds)} />

  <!-- Marks the foot of the hero: the script reveals the Browse rail once this
       scrolls above the viewport. -->
  <div id="hero-sentinel" aria-hidden="true"></div>

  <!-- Region/era filters for the entity index: pure client-side row-hiding
       over data attributes already in the DOM. Hidden until JS removes the
       attribute, so a no-JS visitor sees the plain full index. -->
  <form class="filters" id="filters" hidden aria-label="Filter the index">
    <fieldset class="filter-group" id="filter-region">
      <legend class="filters-label">Region</legend>
      {regionOptions.map(([key, label]) => (
        <button type="button" class="chip" data-value={key} aria-pressed="false">{label}</button>
      ))}
    </fieldset>
    <fieldset class="filter-group era-group" id="filter-era">
      <legend class="filters-label">Era</legend>
      {(() => {
        const t0 = ERAS[0].start;
        const t1 = ERAS[ERAS.length - 1].end;
        const span = t1 - t0;
        const pct = (y: number) => ((y - t0) / span) * 100;
        const fmt = (y: number) => (y < 0 ? `${-y} BCE` : `${y} CE`);
        const w = (e: (typeof ERAS)[number]) => (((e.end - e.start) / span) * 100).toFixed(2);
        return (
          <div class="era-wrap">
            <div class="era-names" role="group" aria-label="The ages of the atlas">
              {ERAS.map((e) => (
                <button
                  type="button"
                  class="era-name"
                  data-era={e.key}
                  data-start={e.start}
                  data-end={e.end}
                  aria-expanded="false"
                  aria-controls={`era-note-${e.key}`}
                  title={e.label}
                  style={`width: ${w(e)}%`}
                >{e.label.split(' (')[0]}</button>
              ))}
            </div>
            <div class="era-line">
              {ERAS.map((e, i) => (
                <button
                  type="button"
                  class="era-seg"
                  data-era={e.key}
                  tabindex="-1"
                  aria-hidden="true"
                  title={e.label}
                  style={`width: ${w(e)}%; --tint: ${8 + i * 7}%`}
                ></button>
              ))}
            </div>
            <div class="era-years" aria-hidden="true">
              {[ERAS[0].start, ...ERAS.map((e) => e.end)].map((y) => (
                <span style={`left: ${pct(y).toFixed(2)}%`}>{fmt(y)}</span>
              ))}
            </div>
            {ERAS.map((e) => (
              <div class="era-note corner-ticks" id={`era-note-${e.key}`} hidden>
                <div class="era-note-head">
                  <strong>{e.label.split(' (')[0]}</strong>
                  <span class="era-note-span">{ERA_NOTES[e.key].span}</span>
                  <button type="button" class="era-note-close" data-era={e.key} aria-label="Close">×</button>
                </div>
                <div class="era-note-body" set:html={ERA_NOTES[e.key].html} />
              </div>
            ))}
          </div>
        );
      })()}
    </fieldset>
    <span class="filters-count" id="filters-count" aria-live="polite"></span>
  </form>

  <div class="index-grid">
    <div class="index-col corner-ticks">
      {(() => {
        const byName = (a: typeof civs[number], b: typeof civs[number]) =>
          a.data.english_name.localeCompare(b.data.english_name);
        const grouped = {
          civilization: civs.filter((c) => c.data.type === 'civilization').sort(byName),
          city: civs.filter((c) => c.data.type === 'city').sort(byName),
          region: civs.filter((c) => c.data.type === 'region').sort(byName),
          geographic_feature: civs.filter((c) => c.data.type === 'geographic_feature').sort(byName),
        };
        const labels = {
          civilization: 'Civilizations',
          city: 'Cities',
          region: 'Regions',
          geographic_feature: 'Geographic features',
        };
        const order = ['civilization', 'city', 'region', 'geographic_feature'] as const;
        return order
          .filter((key) => grouped[key].length > 0)
          .map((key) => (
            <section class="index-cat">
              <h2 id={key}>{labels[key]}</h2>
              <ul class="index-list">
                {grouped[key].map((entity) => (
                  <li
                    data-slug={entity.id}
                    data-mregion={MACRO_REGION_OF[entity.id]}
                    data-start={entity.data.era_start}
                    data-end={entity.data.era_end ?? 9999}
                  >
                    <a href={`/civilizations/${entity.id}`}>
                      <span class="name">{entity.data.english_name}</span>
                      <span class="row-meta">
                        <span class={`count count-${entity.data.entry_status}`} title={`${countByCiv.get(entity.id) ?? 0} name entries (${entity.data.entry_status})`}>{countByCiv.get(entity.id) ?? 0}</span>
                        <span class="era">{formatEra(entity.data.era_start, entity.data.era_end)}</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ));
      })()}
    </div>

    <div class="index-col corner-ticks">
      <section class="index-cat">
        <h2 id="languages">Languages</h2>
        <ul class="index-list">
          {langs.map((lang) => (
            <li>
              <a href={`/languages/${lang.id}`}>
                <span class="name">{lang.data.english_name}</span>
                <span class="row-meta">
                  <span class="count count-language" title={`${countByLang.get(lang.id) ?? 0} name entries`}>{countByLang.get(lang.id) ?? 0}</span>
                  {lang.data.native_name ? (
                    <span
                      class="era endonym"
                      lang={lang.data.lang_code}
                      dir={lang.data.direction === 'rtl' ? 'rtl' : undefined}
                      title={lang.data.script}
                    >{lang.data.native_name}</span>
                  ) : (
                    <span class="era era-script" title={lang.data.script}>{lang.data.script}</span>
                  )}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  /* A rough table of contents pinned in the left gutter on wide screens, so a
     reader can jump between the entity categories without scrolling the long
     index. It sits in the empty margin beside the centered 720px column and is
     hidden once the window is too narrow to hold it without overlapping. */
  /* Wears the same panel dress as the entity pages' Contents box (border,
     grain, soft shadow, rounded corners), so the two rails read as one
     device; the per-section colors below stay. */
  .home-toc {
    position: fixed;
    top: 7.5rem;
    left: calc((100vw - var(--max-width)) / 2 - 16.5rem);
    width: 16rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    z-index: 5;
    border: 1px solid var(--rule-strong);
    border-radius: 6px;
    background-image: var(--grain);
    box-shadow: var(--shadow-soft);
    padding: 0.9rem 1.1rem;
    /* Hidden on arrival so it never crowds the masthead and the fading-in
       header; the script reveals it once the hero scrolls past. */
    opacity: 0;
    transform: translateX(-6px);
    pointer-events: none;
  }
  .home-toc.is-visible { opacity: 1; transform: none; pointer-events: auto; }
  @media (prefers-reduced-motion: no-preference) {
    .home-toc { transition: opacity 0.45s ease, transform 0.45s ease; }
  }
  .home-toc-title {
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-size: 0.6875rem;
    color: var(--ink-soft);
  }
  /* Entity categories (left) and Languages (right) sit in parallel columns, the
     same split as the index content below. */
  .home-toc-cols { display: flex; gap: 1.4rem; align-items: start; }
  .home-toc-col { display: flex; flex-direction: column; gap: 0.5rem; min-width: 0; }
  .home-toc-col:first-child { flex: 1 1 auto; }
  .home-toc a {
    white-space: nowrap;
