---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not Found" description="This page is not in the atlas.">
  <h1>404</h1>
  <p class="notfound">That name is not in the atlas. The page you were looking for does not exist, or has moved.</p>

  <!-- The header's search bar sits directly above; no second input needed. -->
  <p class="notfound-hint">Try the search bar above, or browse:</p>

  <nav class="notfound-browse" aria-label="Browse the atlas">
    <a href="/#civilization">Civilizations</a>
    <a href="/#city">Cities</a>
    <a href="/#region">Regions</a>
    <a href="/#geographic_feature">Geographic features</a>
    <a href="/#languages">Languages</a>
  </nav>
</BaseLayout>

<style>
  .notfound { color: var(--ink-soft); margin: 1rem 0 1.5rem; }
  .notfound-hint { font-family: 'Inter', sans-serif; font-size: 0.875rem; color: var(--ink-soft); margin: 0 0 0.75rem; }
  .notfound-browse {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
  }
  .notfound-browse-label { color: var(--ink-soft); }
  .notfound-browse a { text-decoration: none; }
  .notfound-browse a:hover { text-decoration: underline; }
</style>
