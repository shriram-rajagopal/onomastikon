---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not Found" description="This page is not in the atlas.">
  <h1>404</h1>
  <p class="notfound">That name is not in the atlas. The page you were looking for does not exist, or has moved.</p>

  <!-- Plain GET form: /search reads ?q= on load, so this works without JS. -->
  <form class="notfound-search" action="/search" method="get" role="search">
    <input
      type="search"
      name="q"
      aria-label="Search the atlas"
      placeholder="Search for a name…"
    />
    <button type="submit">Search</button>
  </form>

  <nav class="notfound-browse" aria-label="Browse the atlas">
    <span class="notfound-browse-label">Or browse:</span>
    <a href="/#civilization">Civilizations</a>
    <a href="/#city">Cities</a>
    <a href="/#region">Regions</a>
    <a href="/#geographic_feature">Geographic features</a>
    <a href="/#languages">Languages</a>
  </nav>
</BaseLayout>

<style>
  .notfound { color: var(--ink-soft); margin: 1rem 0 1.5rem; }
  .notfound-search { display: flex; gap: 0.5rem; max-width: 26rem; margin: 0 0 1.5rem; }
  .notfound-search input {
    flex: 1;
    font-family: 'EB Garamond', Georgia, serif;
    font-size: 1.125rem;
    padding: 0.5rem 0.7rem;
    background: var(--parchment);
    color: var(--ink);
    border: 1px solid var(--rule);
    border-radius: 4px;
  }
  .notfound-search input:focus { outline: 2px solid var(--accent); outline-offset: 1px; border-color: var(--accent); }
  .notfound-search button {
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    padding: 0.3rem 0.9rem;
    background: var(--parchment);
    color: var(--ink-soft);
    border: 1px solid var(--rule);
    border-radius: 4px;
    cursor: pointer;
  }
  .notfound-search button:hover { color: var(--accent); border-color: var(--accent); }
  .notfound-browse {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
  }
  .notfound-browse-label { color: var(--ink-soft); }
  .notfound-browse a { text-decoration: none; }
  .notfound-browse a:hover { text-decoration: underline; }
</style>
