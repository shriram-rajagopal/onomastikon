---
// Compare is no longer a page: it opens as a dialog over whatever page the
// reader is on (ComparePanel, in BaseLayout), so comparing never navigates
// away. This stub keeps old /compare?a=…&b=… links alive by forwarding the
// query to the homepage, where the dialog auto-opens from the parameters.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Compare — Onomastikon</title>
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content="0;url=/" />
    <script>
      location.replace('/' + location.search);
    </script>
  </head>
  <body>
    <p>Compare now opens over any page of the atlas. <a href="/">Continue to the atlas.</a></p>
  </body>
</html>
