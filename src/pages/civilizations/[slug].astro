---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { entryAnchor } from '../../lib/entry';
import { pageDates, modifiedOf, formatMonthYear } from '../../lib/dates';
import { citationParts } from '../../lib/citation';
import { formatEra } from '../../lib/era';
import { familyDisplay } from '../../lib/families';
import FamilyNode from '../../components/FamilyNode.astro';
import type { TreeNode } from '../../components/FamilyNode.astro';
import CiteThis from '../../components/CiteThis.astro';
import AttestationTimeline from '../../components/AttestationTimeline.astro';
import TransmissionMap from '../../components/TransmissionMap.astro';
import ArtifactViewer from '../../components/ArtifactViewer.astro';
import LocatorMap from '../../components/LocatorMap.astro';
import HelpTip from '../../components/HelpTip.astro';
import { LANG_GEO } from '../../lib/geo';
import { ARTIFACTS } from '../../lib/artifacts';

export async function getStaticPaths() {
  const civs = await getCollection('civilizations');
  // One ordered walk through the whole atlas for the prev/next pager: grouped by
  // type (civilizations, then cities, regions, features), alphabetical within
  // each group, matching the homepage index.
  const typeOrder: Record<string, number> = { civilization: 0, city: 1, region: 2, geographic_feature: 3 };
  const ordered = [...civs].sort((a, b) => {
    const t = (typeOrder[a.data.type] ?? 9) - (typeOrder[b.data.type] ?? 9);
    return t !== 0 ? t : a.data.english_name.localeCompare(b.data.english_name);
  });
  const nav = (e?: (typeof ordered)[number]) =>
    e ? { id: e.id, name: e.data.english_name } : null;
  return ordered.map((civ, i) => ({
    params: { slug: civ.id },
    props: { civ, prev: nav(ordered[i - 1]), next: nav(ordered[i + 1]) },
  }));
}

const { civ, prev, next } = Astro.props;
const { Content } = await render(civ);

const allNames = await getCollection('names');
const namesForCiv = allNames
  .filter((n) => n.data.civilization.id === civ.id)
  .sort((a, b) => (a.data.era_start ?? 0) - (b.data.era_start ?? 0));

const enriched = await Promise.all(
  namesForCiv.map(async (n) => {
    const lang = await getEntry(n.data.language);
    const { Content } = await render(n);
    return { name: n, language: lang, Content };
  })
);

const byId = new Map(enriched.map((e) => [e.name.id, e]));

// Transmission trees: group the page's names by family, then hang each name
// under its asserted parent (derived_from). Names with no asserted parent in
// the family sit at the top level as cognate siblings. enriched is era-sorted,
// so roots and children inherit chronological order.
type Enriched = (typeof enriched)[number];
function toNode(e: Enriched): TreeNode {
  return {
    id: e.name.id,
    original_text: e.name.data.original_text,
    transliteration: e.name.data.transliteration,
    languageName: e.language?.data.english_name ?? '',
    langCode: e.language?.data.lang_code,
    rtl: e.language?.data.direction === 'rtl',
    era: formatEra(e.name.data.era_start, e.name.data.era_end),
    children: [],
  };
}
const familyGroups = new Map<string, Enriched[]>();
for (const e of enriched) {
  const fam = e.name.data.family;
  if (!fam) continue;
  if (!familyGroups.has(fam)) familyGroups.set(fam, []);
  familyGroups.get(fam)!.push(e);
}
// A member whose asserted parent lives on ANOTHER entity's page (the Byzantine
// al-Rūm borrowed from Rome's Syriac Rhōmā) must not masquerade as an underived
// root: the parent is rendered as a linked "ghost" card pointing at its own
// page, so the borrowing reads as the data asserts it.
const allLangs = await getCollection('languages');
const langById = new Map(allLangs.map((l) => [l.id, l]));
const allCivs = await getCollection('civilizations');
const civById = new Map(allCivs.map((c) => [c.id, c]));
const namesById = new Map(allNames.map((n) => [n.id, n]));
function ghostNode(n: (typeof allNames)[number]): TreeNode {
  const lang = langById.get(n.data.language.id);
  const homeCiv = n.data.civilization.id;
  return {
    id: n.id,
    original_text: n.data.original_text,
    transliteration: n.data.transliteration,
    languageName: lang?.data.english_name ?? '',
    langCode: lang?.data.lang_code,
    rtl: lang?.data.direction === 'rtl',
    era: formatEra(n.data.era_start, n.data.era_end),
    externalHref: `/civilizations/${homeCiv}#${entryAnchor(n.id, homeCiv)}`,
    externalNote: civById.get(homeCiv)?.data.english_name ?? '',
    children: [],
  };
}
const familyTrees = [...familyGroups.entries()]
  .filter(([, members]) => members.length >= 2)
  .map(([slug, members]) => {
    const nodes = new Map(members.map((m) => [m.name.id, toNode(m)]));
    const roots: TreeNode[] = [];
    const ghosts = new Map<string, TreeNode>();
    for (const m of members) {
      const node = nodes.get(m.name.id)!;
      const parentId = m.name.data.derived_from?.id;
      const parent = parentId ? nodes.get(parentId) : undefined;
      if (parent) {
        parent.children.push(node);
        continue;
      }
      const ext = parentId ? namesById.get(parentId) : undefined;
      if (ext) {
        let g = ghosts.get(parentId!);
        if (!g) {
          g = ghostNode(ext);
          ghosts.set(parentId!, g);
          roots.push(g);
        }
        g.children.push(node);
      } else {
        roots.push(node);
      }
    }
    return { slug, ...familyDisplay(slug), roots, size: members.length };
  })
  .sort((a, b) => b.size - a.size);

// Which sections this page actually has, for the contents rail.
const showFamilies = familyTrees.length > 0;
const showMap = enriched.filter((e) => e.language && LANG_GEO[e.language.id]).length >= 2;
const showTimeline = enriched.length >= 2;
const mapNodes = enriched
  .filter((e) => e.language)
  .map((e) => ({
    id: e.name.id,
    anchor: entryAnchor(e.name.id, civ.id),
    translit: e.name.data.transliteration,
    langId: e.language!.id,
    langName: e.language!.data.english_name,
    start: e.name.data.era_start,
    end: e.name.data.era_end,
  }));
const mapEdges = enriched
  .filter((e) => e.name.data.derived_from)
  .map((e) => ({ from: e.name.data.derived_from!.id, to: e.name.id }));
const contents = [
  ...(showFamilies ? [{ href: '#families', label: 'Name families' }] : []),
  ...(showMap ? [{ href: '#map', label: 'Transmission map' }] : []),
  ...(showTimeline ? [{ href: '#timeline', label: 'Attestation timeline' }] : []),
  { href: '#names', label: 'Names across languages' },
  { href: '#cite', label: 'Cite this page' },
];
const pageUrl = new URL(`/civilizations/${civ.id}`, Astro.site).href;
const dates = pageDates('civilizations', civ.id);
const correctionUrl =
  'https://github.com/shriram-rajagopal/onomastikon/issues/new?template=correction.yml' +
  `&title=${encodeURIComponent(`Correction: ${civ.data.english_name}`)}` +
  `&page-url=${encodeURIComponent(pageUrl)}`;
---

<BaseLayout
  title={civ.data.english_name}
  description={civ.data.summary}
  schema={{
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: civ.data.english_name,
    description: civ.data.summary,
    url: new URL(`/civilizations/${civ.id}`, Astro.site).href,
    author: { '@type': 'Person', name: 'Shriram Rajagopal' },
    license: 'https://creativecommons.org/licenses/by-sa/4.0/',
    inLanguage: 'en',
    isPartOf: { '@type': 'WebSite', name: 'Onomastikon', url: Astro.site?.href },
    ...(dates.published && { datePublished: dates.published }),
    ...(dates.modified && { dateModified: dates.modified }),
  }}
>
  <article>
    <HelpTip title="Reading this entry">
      <ul>
        <li>The small map locates the subject; on it, rivers are context lines and the accent mark is the entity itself.</li>
        <li><strong>Name families</strong> group forms that share one root. A form joined by a solid line was borrowed from the form it hangs under; forms sitting side by side on a dashed rail are parallel descendants of the shared root, not borrowings from each other.</li>
      </ul>
      <div class="hd-tree"><div>Greek <em>Aígyptos</em> (the source)</div><div>Latin <em>Aegyptus</em> (borrowed from it)</div></div>
      <ul>
        <li>The <strong>transmission map</strong> plots each form at its language's homeland; slide the year and forms show as in use, former, or not yet attested.</li>
        <li><strong>Timeline</strong> bars span each name's attestation, not the language's lifespan.</li>
        <li>Confidence: green = attested in sources, tan = reconstructed (starred forms), rust = disputed reading.</li>
        <li>Hover any entry for its # permalink and a copy button; sources sit in each entry's drawer.</li>
      </ul>
    </HelpTip>
    <nav class="pager pager-top" aria-label="Browse the atlas">
      {prev ? (
        <a class="pager-link pager-prev" href={`/civilizations/${prev.id}`} rel="prev">
          <span class="pager-arrow" aria-hidden="true">←</span>
          <span class="pager-name">{prev.name}</span>
        </a>
      ) : <span class="pager-link pager-empty" aria-hidden="true"></span>}
      {next ? (
        <a class="pager-link pager-next" href={`/civilizations/${next.id}`} rel="next">
          <span class="pager-name">{next.name}</span>
          <span class="pager-arrow" aria-hidden="true">→</span>
        </a>
      ) : <span class="pager-link pager-empty" aria-hidden="true"></span>}
    </nav>
    <p class="eyebrow">{
      civ.data.type === 'civilization' ? 'Civilization' :
      civ.data.type === 'city' ? 'City' :
      civ.data.type === 'region' ? 'Region' :
      'Geographic feature'
    }</p>
    <h1>{civ.data.english_name}</h1>
    <p class="meta">
      {civ.data.region} · {formatEra(civ.data.era_start, civ.data.era_end)}
      {dates.modified && ` · Updated ${formatMonthYear(dates.modified)}`}
      <span class={`status status-${civ.data.entry_status}`}>{civ.data.entry_status}</span>
    </p>

    {/* Orients the reader on arrival; the transmission map further down plots
        language homelands, not the entity itself, so the two don't compete. */}
    <LocatorMap civId={civ.id} />

    {enriched.length > 0 && (
      <p class="aka">
        Also known as: {enriched.map(({ name }, i) => (
          <>
            {i > 0 && ', '}
            <a class="aka-link" href={`#${entryAnchor(name.id, civ.id)}`}>{name.data.transliteration}</a>
          </>
        ))}
      </p>
    )}

    <div class="summary"><Content /></div>

    <p class="feedback-top">
      <a href="#site-feedback">Spot an error or have a suggestion? Send feedback ↓</a>
    </p>

    <nav class="toc" aria-label="Contents">
      <!-- details makes the block collapsible where it sits in-flow (narrow
           viewports, where an entry with fifteen languages costs a screenful
           before any content); it stays open by default everywhere. -->
      <details class="toc-drawer" open>
        <summary class="toc-title">Contents</summary>
        <ol class="toc-list">
          {contents.map((c) => (
            <li>
              <a href={c.href}>{c.label}</a>
              {c.href === '#names' && (
                <ol class="toc-langs">
                  {enriched.map(({ name, language }) => (
                    <li><a href={`#${entryAnchor(name.id, civ.id)}`}>{language?.data.english_name}</a></li>
                  ))}
                </ol>
              )}
            </li>
          ))}
        </ol>
      </details>
    </nav>

    {showFamilies && (
      <>
        <h2 id="families">Name families</h2>
        <p class="families-hint">
          Names that share one root, grouped into trees.
          <span class="lg lg-solid" aria-hidden="true"></span> A solid line joins
          a form to the form it was borrowed from;
          <span class="lg lg-dashed" aria-hidden="true"></span> forms hanging
          together from a dashed rail are parallel descendants of the shared
          root, with no borrowing asserted between them. A dashed card is the
          off-page source of a chain: it lives on another entity's page, and
          links there.
        </p>
        {familyTrees.map((fam) => (
          <section class="family corner-ticks">
            <h3 class="family-title">{fam.display}</h3>
            {fam.note && <p class="family-note">{fam.note}</p>}
            {fam.roots.length > 1 ? (
              <div class="family-cognates">
                <span class="cognates-label">one shared root · parallel descendants</span>
                <ul class="family-roots cognate-row">
                  {fam.roots.map((node) => <FamilyNode node={node} civId={civ.id} />)}
                </ul>
              </div>
            ) : (
              <ul class="family-roots">
                {fam.roots.map((node) => <FamilyNode node={node} civId={civ.id} />)}
              </ul>
            )}
          </section>
        ))}
      </>
    )}

    {showMap && (
      <section class="tmap" id="map">
        <h2>Transmission map</h2>
        <p class="families-hint">
          Each form at the homeland of its language; arcs follow asserted
          borrowing paths. Slide to a year to see which names were in use.
        </p>
        <TransmissionMap civId={civ.id} nodes={mapNodes} edges={mapEdges} />
      </section>
    )}

    {showTimeline && (
      <section class="timeline" id="timeline">
        <h2>Attestation timeline</h2>
        <p class="families-hint">When each name is attested, earliest first. Dates bound the name's use, not the language's lifespan.</p>
        <AttestationTimeline
          entries={enriched.map((e) => ({
            anchor: entryAnchor(e.name.id, civ.id),
            label: e.language?.data.english_name ?? '',
            translit: e.name.data.transliteration,
            start: e.name.data.era_start,
            end: e.name.data.era_end,
          }))}
        />
      </section>
    )}

    <h2 id="names">Names across languages</h2>

    {enriched.length === 0 && <p><em>No name entries yet.</em></p>}

    {enriched.map(({ name, language, Content }) => (
      <section class="name-entry corner-ticks" id={entryAnchor(name.id, civ.id)}>
        <h3>
          <a class="lang-link" href={`/languages/${language?.id}`}>{language?.data.english_name}</a>
          <span class="name-era">{formatEra(name.data.era_start, name.data.era_end)}</span>
          <a
            class="entry-anchor"
            href={`#${entryAnchor(name.id, civ.id)}`}
            aria-label={`Permalink to the ${language?.data.english_name} entry`}
          >#</a>
          <button
            type="button"
            class="entry-copy"
            data-copy={`${entryAnchor(name.id, civ.id)}-copytext`}
            aria-label={`Copy the ${language?.data.english_name} form and transliteration`}
          >copy</button>
        </h3>
        <span hidden id={`${entryAnchor(name.id, civ.id)}-copytext`}>{
          [name.data.original_text, name.data.transliteration].filter(Boolean).join(' ')
        }</span>
        {name.data.original_text && (
          <p
            class="original"
            lang={language?.data.lang_code}
            dir={language?.data.direction === 'rtl' ? 'rtl' : undefined}
          >{name.data.original_text}</p>
        )}
        <dl>
          <dt>Transliteration</dt><dd><em>{name.data.transliteration}</em></dd>
          {(name.data.ipa || name.data.audio) && (
            <>
              <dt>IPA</dt>
              <dd>
                {name.data.ipa}
                {name.data.audio && (
                  <button
                    type="button"
                    class="audio-play"
                    data-audio={name.data.audio}
                    aria-label={`Play the reconstructed pronunciation of ${name.data.transliteration}`}
                  >▶</button>
                )}
                {name.data.audio && name.data.audio_note && (
                  <span class="audio-note">{name.data.audio_note}</span>
                )}
              </dd>
            </>
          )}
          {name.data.literal_meaning && (<><dt>Meaning</dt><dd>“{name.data.literal_meaning}”</dd></>)}
          {name.data.derived_from && byId.get(name.data.derived_from.id) && (
            <>
              <dt>Derived from</dt>
              <dd>
                <a class="derived-link" href={`#${entryAnchor(name.data.derived_from.id, civ.id)}`}>
                  {byId.get(name.data.derived_from.id)!.language?.data.english_name}{' '}
                  <em>{byId.get(name.data.derived_from.id)!.name.data.transliteration}</em>
                </a>
              </dd>
            </>
          )}
          <dt>Confidence</dt>
          <dd>
            <span class={`confidence confidence-${name.data.confidence}`}>
              {name.data.confidence}
            </span>
          </dd>
        </dl>
        <div class="name-body">
          <Content />
        </div>
        {ARTIFACTS[name.id] && <ArtifactViewer artifact={ARTIFACTS[name.id]} />}
        <details class="sources">
          <summary>Sources ({name.data.sources.length})</summary>
          <ol>
            {name.data.sources.map((s) => (
              <li>
                {citationParts(s.citation).map((part) => (part.em ? <em>{part.text}</em> : part.text))}{s.page && <>, p. {s.page}</>}
                {s.url && <> <a href={s.url} aria-label={`Open source: ${s.citation.replaceAll('*', '')}`}>↗</a></>}
              </li>
            ))}
          </ol>
        </details>
        <CiteThis
          compact
          title={`${name.data.transliteration} (${language?.data.english_name} name for ${civ.data.english_name})`}
          path={`/civilizations/${civ.id}`}
          anchor={entryAnchor(name.id, civ.id)}
          modified={modifiedOf(`names/${name.id}`)}
        />
      </section>
    ))}

    <CiteThis title={civ.data.english_name} path={`/civilizations/${civ.id}`} modified={dates.modified} />
    <p class="suggest-correction">
      Spot an error on this page? <a href={correctionUrl}>Suggest a correction →</a>
    </p>

    <nav class="pager" aria-label="Browse the atlas">
      {prev ? (
        <a class="pager-link pager-prev" href={`/civilizations/${prev.id}`} rel="prev">
          <span class="pager-dir">← Previous</span>
          <span class="pager-name">{prev.name}</span>
        </a>
      ) : <span class="pager-link pager-empty" aria-hidden="true"></span>}
      {next ? (
        <a class="pager-link pager-next" href={`/civilizations/${next.id}`} rel="next">
          <span class="pager-dir">Next →</span>
          <span class="pager-name">{next.name}</span>
        </a>
      ) : <span class="pager-link pager-empty" aria-hidden="true"></span>}
    </nav>
  </article>
</BaseLayout>

<script>
  // Family-tree animation. Reveal: each family section's nodes fade in with a
  // stagger when scrolled into view; opted in by JS so no-JS and
  // reduced-motion visitors always see the full tree. Trace: hovering or
  // focusing a form lights its ancestor chain back to the root.
  const families = document.querySelectorAll('.family');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduceMotion && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('revealed');
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.15 }
    );
    for (const f of families) {
      f.querySelectorAll<HTMLElement>('.family-node').forEach((n, i) =>
        n.style.setProperty('--reveal-delay', `${Math.min(i * 90, 900)}ms`)
      );
      f.classList.add('anim');
      io.observe(f);
    }
    // The attestation timeline's bars and the map's arcs draw in on the
    // same trigger.
    for (const t of document.querySelectorAll('.timeline, .tmap')) {
      t.classList.add('anim');
      io.observe(t);
    }
  }
  // Contents scrollspy: highlight the link for the section (or the language
  // entry) currently near the top of the viewport.
  const toc = document.querySelector('.toc');
  if (toc && 'IntersectionObserver' in window) {
    const links = new Map(
      [...toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')].map((a) => [a.getAttribute('href')!.slice(1), a])
    );
    const spy = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          for (const l of links.values()) l.classList.remove('active');
          links.get(e.target.id)?.classList.add('active');
        }
      },
      { rootMargin: '-15% 0px -75% 0px' }
    );
    for (const id of links.keys()) {
      const target = document.getElementById(id);
      if (target) spy.observe(target);
    }
  }

  function setLineage(card: Element, on: boolean) {
    let li: Element | null = card.closest('.family-node');
    while (li) {
      li.querySelector(':scope > .node-card')?.classList.toggle('lit', on);
      const rail: Element | null = li.parentElement?.closest('.family-children') ?? null;
      rail?.classList.toggle('lit', on);
      li = rail ? rail.closest('.family-node') : null;
    }
  }
  for (const f of families) {
    for (const [over, out] of [['mouseover', 'mouseout'], ['focusin', 'focusout']] as const) {
      f.addEventListener(over, (ev) => {
        const card = (ev.target as Element).closest('.node-card');
        if (card) setLineage(card, true);
      });
      f.addEventListener(out, (ev) => {
        const card = (ev.target as Element).closest('.node-card');
        if (card) setLineage(card, false);
      });
    }
  }
</script>

<script>
  // Pronunciation players: an <audio> is created on first press (preload
  // costs nothing until then), one plays at a time, and the button reflects
  // playing state.
  let playing: { el: HTMLAudioElement; btn: HTMLButtonElement } | null = null;
  const stop = () => {
    if (!playing) return;
    playing.el.pause();
    playing.el.currentTime = 0;
    playing.btn.textContent = '▶';
    playing = null;
  };
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.audio-play')) {
    let el: HTMLAudioElement | null = null;
    btn.addEventListener('click', () => {
      if (playing?.btn === btn) {
        stop();
        return;
      }
      stop();
      el ??= new Audio(btn.dataset.audio!);
      el.onended = stop;
      playing = { el, btn };
      btn.textContent = '⏸';
      el.play().catch(stop);
    });
  }
</script>

<script>
  // Sources live inside collapsed <details>, which print as just the summary
  // line. Open them for printing and restore the reader's state afterwards.
  let openedForPrint: HTMLDetailsElement[] = [];
  window.addEventListener('beforeprint', () => {
    openedForPrint = [...document.querySelectorAll<HTMLDetailsElement>('details:not([open])')];
    openedForPrint.forEach((d) => (d.open = true));
  });
  window.addEventListener('afterprint', () => {
    openedForPrint.forEach((d) => (d.open = false));
    openedForPrint = [];
  });
</script>

<style>
  .eyebrow { font-family: 'Inter', sans-serif; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-soft); margin: 0 0 0.5rem; }
  .meta { font-family: 'Inter', sans-serif; font-size: 0.875rem; color: var(--ink-soft); margin: 0.25rem 0 1rem; }
  .status {
    font-family: 'Inter', sans-serif;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
    margin-left: 0.5rem;
    vertical-align: middle;
  }
  .status-developing { background: var(--badge-developing-bg); color: var(--badge-developing-fg); }
  .status-complete { background: var(--badge-complete-bg); color: var(--badge-complete-fg); }
  .aka { font-style: italic; color: var(--ink-soft); margin-bottom: 1.5rem; }
  /* Each form links to its entry below; dressed as the surrounding prose so
