---
// Search is no longer a page: the site-wide bar under the header (SiteSearch,
// in BaseLayout) is the one search affordance, and it honors the old ?q=
// contract on any page. This stub only keeps a decade of possible /search?q=
// bookmarks and inbound links alive, forwarding the query to the homepage.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Search — Onomastikon</title>
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content="0;url=/" />
    <script>
      location.replace('/' + location.search);
    </script>
  </head>
  <body>
    <p>Search now lives in the bar at the top of every page. <a href="/">Continue to the atlas.</a></p>
  </body>
</html>
