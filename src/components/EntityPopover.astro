---
// Hover-preview popover for the auto-crossreference links (.xref) in prose and
// for the language labels on name cards (.lang-link, beside the dates). Rest
// the cursor on a linked name and, after the same beat as the homepage index
// menu, a card rises anchored over the word.
//
// Two card shapes share one element:
//   - a CIVILIZATION card: summary, locator minimap, region · era, status, and
//     name count (the same card the homepage uses);
//   - a LANGUAGE card: the language name, its endonym in its own script, the
//     language family, the alphabet, and a short blurb.
//
// Deliberately its own element (#xref-pop), separate from the homepage's
// #entity-pop, so the two never interfere. It holds the horizontal band the
// transmission map and family trees set, clamping inside that column.
import { getCollection } from 'astro:content';
import { formatEra } from '../lib/era';

const [civs, langs, names] = await Promise.all([
  getCollection('civilizations'),
  getCollection('languages'),
  getCollection('names'),
]);

const countByCiv = new Map<string, number>();
for (const n of names) {
  const id = n.data.civilization.id;
  countByCiv.set(id, (countByCiv.get(id) ?? 0) + 1);
}

const popData = Object.fromEntries(
  civs.map((c) => [
    c.id,
    {
      n: c.data.english_name,
      s: c.data.summary,
      r: c.data.region ?? '',
      e: formatEra(c.data.era_start, c.data.era_end),
      st: c.data.entry_status,
      c: countByCiv.get(c.id) ?? 0,
    },
  ])
);

// The language blurb is the opening sentence of its own (vetted) description,
// stripped of markdown and capped, so it reads like an entity summary without
// a second field to author. Split on a sentence break that a capital or quote
// follows, which leaves "c. 1500 BCE" and the like intact.
const firstSentence = (body: string): string => {
  const text = (body ?? '').trim();
  if (!text) return '';
  let s = text.split(/(?<=[.!?])\s+(?=[A-Z“"'ʾʿ])/)[0] ?? text;
  s = s
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1') // [text](url) -> text
    .replace(/[*_]/g, '') // italic / bold markers
    .replace(/\s+/g, ' ')
    .trim();
  if (s.length > 240) s = s.slice(0, 220).replace(/\s+\S*$/, '') + '…';
  return s;
};

const langData = Object.fromEntries(
  langs.map((l) => [
    l.id,
    {
      n: l.data.english_name,
      endo: l.data.native_name ?? '',
      code: l.data.lang_code,
      dir: l.data.direction === 'rtl' ? 'rtl' : '',
      fam: l.data.language_family,
      script: l.data.script,
      blurb: firstSentence(l.body),
    },
  ])
);
---

<aside id="xref-pop" class="corner-ticks" aria-live="polite" hidden>
  <p class="xp-name" id="xp-name"></p>
  {/* Civilization fields */}
  <div class="xp-entity">
    <p class="xp-sub"><span id="xp-region"></span> · <span id="xp-era"></span></p>
    <p class="xp-badges"><span id="xp-status" class="status"></span><span id="xp-count" class="xp-count"></span></p>
    <div id="xp-map" class="xp-map" aria-hidden="true"></div>
  </div>
  {/* Language fields */}
  <div class="xp-lang">
    <p class="xp-endo" id="xp-endo"></p>
    <p class="xp-meta" id="xp-meta"></p>
  </div>
  <p id="xp-summary" class="xp-summary"></p>
</aside>
<script type="application/json" id="xref-pop-entities" set:html={JSON.stringify(popData)} />
<script type="application/json" id="xref-pop-langs" set:html={JSON.stringify(langData)} />

<script>
  {
    const pop = document.getElementById('xref-pop');
    const entEl = document.getElementById('xref-pop-entities');
    const langEl = document.getElementById('xref-pop-langs');
    if (pop && entEl && langEl && matchMedia('(hover: hover)').matches) {
      const entData = JSON.parse(entEl.textContent!);
      const langData = JSON.parse(langEl.textContent!);
      const mapCache = new Map<string, string>();
      const el = (id: string) => document.getElementById(id)!;
      let showTimer = 0;
      let hideTimer = 0;
      let shownFor: string | null = null;

      const hide = () => {
        pop.classList.remove('show');
        shownFor = null;
        window.setTimeout(() => { if (!shownFor) pop.hidden = true; }, 240);
      };

      // The horizontal band the popover stays inside: the width the transmission
      // map and family trees set (the widest content). Falls back to the prose
      // column, then a viewport inset.
      const columnBounds = () => {
        const ref =
          document.querySelector('.tmap-svg') ||
          document.getElementById('families') ||
          document.querySelector('.summary') ||
          document.getElementById('main');
        if (ref) {
          const r = ref.getBoundingClientRect();
          if (r.width > 0) return { left: r.left, right: r.right };
        }
        return { left: 12, right: innerWidth - 12 };
      };

      const place = (word: HTMLElement) => {
        const a = word.getBoundingClientRect();
        const b = columnBounds();
        const w = pop.offsetWidth;
        const left = Math.min(Math.max(a.left + a.width / 2 - w / 2, b.left), b.right - w);
        let top = a.top - pop.offsetHeight - 10;
        if (top < 76) top = a.bottom + 10; // no room above → drop below
        pop.style.left = `${Math.round(left)}px`;
        pop.style.top = `${Math.round(top)}px`;
      };

      const showEntity = async (slug: string, word: HTMLElement) => {
        const d = entData[slug];
        if (!d) return;
        pop.dataset.kind = 'entity';
        el('xp-name').textContent = d.n;
        el('xp-region').textContent = d.r;
        el('xp-era').textContent = d.e;
        const status = el('xp-status');
        status.textContent = d.st;
        status.className = `status status-${d.st}`;
        el('xp-count').textContent = `${d.c} name ${d.c === 1 ? 'entry' : 'entries'}`;
        el('xp-summary').textContent = d.s;
        const holder = el('xp-map');
        holder.innerHTML = '';
        if (!mapCache.has(slug)) {
          try {
            const r = await fetch(`/locators/${slug}.svg`);
            mapCache.set(slug, r.ok ? await r.text() : '');
          } catch {
            mapCache.set(slug, '');
          }
        }
        holder.innerHTML = mapCache.get(slug) ?? '';
        reveal(word, slug);
      };

      const showLang = (slug: string, word: HTMLElement) => {
        const d = langData[slug];
        if (!d) return;
        pop.dataset.kind = 'lang';
        el('xp-name').textContent = d.n;
        const endo = el('xp-endo');
        endo.textContent = d.endo || '';
        endo.hidden = !d.endo;
        if (d.endo) {
          endo.setAttribute('lang', d.code);
          if (d.dir) endo.setAttribute('dir', 'rtl');
          else endo.removeAttribute('dir');
        }
        el('xp-meta').textContent = `${d.fam} · ${d.script}`;
        el('xp-summary').textContent = d.blurb;
        reveal(word, slug);
      };

      const reveal = (word: HTMLElement, slug: string) => {
        pop.hidden = false;
        place(word);
        shownFor = slug;
        requestAnimationFrame(() => pop.classList.add('show'));
      };

      const hrefSlug = (a: HTMLAnchorElement, base: string) => {
        const m = a.getAttribute('href')?.match(new RegExp(`^${base}([^#?]+)`));
        return m ? m[1] : null;
      };

      // Timing matched to the homepage index menu: 550ms in, 180ms out.
      const wire = (a: HTMLAnchorElement, run: () => void) => {
        a.addEventListener('mouseenter', () => {
          window.clearTimeout(showTimer);
          window.clearTimeout(hideTimer);
          showTimer = window.setTimeout(run, 550);
        });
        a.addEventListener('mouseleave', () => {
          window.clearTimeout(showTimer);
          hideTimer = window.setTimeout(hide, 180);
        });
        a.addEventListener('focus', run);
        a.addEventListener('blur', () => { hideTimer = window.setTimeout(hide, 180); });
      };

      // Civilization crossrefs in prose.
      for (const a of document.querySelectorAll<HTMLAnchorElement>('a.xref[href^="/civilizations/"]')) {
        const slug = hrefSlug(a, '/civilizations/');
        if (slug && entData[slug]) wire(a, () => showEntity(slug, a));
      }
      // Language crossrefs in prose, and the language label on every name card.
      for (const a of document.querySelectorAll<HTMLAnchorElement>('a.xref[href^="/languages/"], a.lang-link[href^="/languages/"]')) {
        const slug = hrefSlug(a, '/languages/');
        if (slug && langData[slug]) wire(a, () => showLang(slug, a));
      }

      pop.addEventListener('mouseenter', () => window.clearTimeout(hideTimer));
      pop.addEventListener('mouseleave', () => { hideTimer = window.setTimeout(hide, 180); });
      addEventListener('scroll', () => { if (shownFor) hide(); }, { passive: true });
      addEventListener('keydown', (e) => { if (e.key === 'Escape' && shownFor) hide(); });
    }
  }
</script>

<style>
  #xref-pop {
    position: fixed;
    width: 300px;
    max-width: calc(100vw - 24px);
    z-index: 30;
    background-color: color-mix(in srgb, var(--ink) 2%, var(--parchment));
    background-image: var(--grain);
    border: 1px solid var(--rule-strong);
    border-radius: 6px;
    padding: 1rem 1.15rem 1.1rem;
    box-shadow: var(--shadow-lift);
    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    #xref-pop { transition: opacity 0.22s ease, transform 0.22s ease; }
  }
  #xref-pop.show { opacity: 1; transform: none; pointer-events: auto; }
  /* Show only the block that matches the current target's kind. */
  #xref-pop .xp-entity, #xref-pop .xp-lang { display: none; }
  #xref-pop[data-kind='entity'] .xp-entity { display: block; }
  #xref-pop[data-kind='lang'] .xp-lang { display: block; }
  #xref-pop .xp-name { margin: 0; font-family: 'EB Garamond', Georgia, serif; font-weight: 600; font-size: 1.25rem; }
  .xp-sub { font-family: 'Inter', sans-serif; font-size: 0.75rem; color: var(--ink-soft); margin: 0.25rem 0 0.5rem; }
  .xp-badges { display: flex; align-items: center; gap: 0.6rem; margin: 0 0 0.6rem; }
  #xref-pop .status {
    font-family: 'Inter', sans-serif;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
  }
  #xref-pop .status-developing { background: var(--badge-developing-bg); color: var(--badge-developing-fg); }
  #xref-pop .status-complete { background: var(--badge-complete-bg); color: var(--badge-complete-fg); }
  .xp-count { font-family: 'Inter', sans-serif; font-size: 0.75rem; color: var(--ink-soft); }
  .xp-map { margin: 0 0 0.6rem; }
  /* Language endonym, in its own script; the stack matches the entity page's
     original-script forms so every alphabet renders. */
  .xp-endo {
    margin: 0.3rem 0 0.4rem;
    font-family: 'EB Garamond', 'Noto Sans Egyptian Hieroglyphs', 'Noto Sans Cuneiform', 'Noto Sans Old Persian', 'Noto Sans Avestan', 'Noto Serif Devanagari', 'Noto Serif Hebrew', 'Noto Naskh Arabic', 'Noto Sans Coptic', 'Noto Sans Ethiopic', 'Noto Sans Inscriptional Pahlavi', 'Noto Sans Inscriptional Parthian', 'Noto Sans Manichaean', 'Noto Sans Syriac', 'Noto Sans Phoenician', 'Noto Sans Ugaritic', 'Noto Sans Lycian', 'Noto Serif Armenian', 'Noto Sans Old Italic', 'Noto Sans Linear B', 'Noto Sans Tamil', 'Noto Sans Brahmi', 'Noto Sans Old Sogdian', 'Noto Sans Old Turkic', serif;
    font-size: 1.35rem;
    line-height: 1.2;
    color: var(--ink);
  }
  .xp-meta { font-family: 'Inter', sans-serif; font-size: 0.75rem; color: var(--ink-soft); margin: 0 0 0.6rem; }
  .xp-summary { font-size: 0.9375rem; line-height: 1.55; margin: 0; color: var(--ink); }
  @media (hover: none) {
    #xref-pop { display: none; }
  }
</style>
