---
// Mini locator: a small static map orienting the reader on pages that carry
// one. The SVG itself comes from the shared builder in src/lib/locator.ts
// (also used by the /locators/<slug>.svg endpoint and the homepage's hover
// popovers); its classes are styled globally in BaseLayout so the same
// markup reads correctly in every context.
import { locatorSvg, locatorLabel } from '../lib/locator';

interface Props {
  civId: string;
}
const { civId } = Astro.props;
const svg = locatorSvg(civId);
const label = locatorLabel(civId);
---

{svg && (
  <figure class="locator">
    <Fragment set:html={svg} />
    <figcaption>{label}</figcaption>
  </figure>
)}

<style>
  .locator {
    float: right;
    width: min(320px, 48%);
    margin: 0.25rem 0 0.9rem 1.5rem;
  }
  .locator figcaption {
    font-family: 'Inter', sans-serif;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    text-align: center;
    margin-top: 0.35rem;
  }
  /* Stacked, not floated, once the column is narrow. */
  @media (max-width: 640px) {
    .locator { float: none; margin: 1rem auto; }
  }
  @media print {
    .locator { break-inside: avoid; }
  }
</style>
