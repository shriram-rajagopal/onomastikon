---
// Transmission map: each of an entity's name-forms plotted at its language's
// homeland on a parchment-styled map of the ancient world, with asserted
// borrowing paths (derived_from) drawn as arcs. The era slider fades out
// forms not yet attested at the chosen year. Server-rendered SVG; the only
// script is the slider and the motion-gated arc draw-in.
import { COAST_PATH, COAST_VIEWBOX } from '../lib/coastline';
import { LANG_GEO, projectGeo } from '../lib/geo';
import { formatEra } from '../lib/era';

export interface MapNode {
  id: string;
  anchor: string;
  translit: string;
  langId: string;
  langName: string;
  start: number;
  end: number;
}

interface Props {
  nodes: MapNode[];
  edges: Array<{ from: string; to: string }>;
  civId: string;
}
const { nodes, edges, civId } = Astro.props;

const placed = nodes
  .filter((n) => LANG_GEO[n.langId])
  .map((n) => {
    const geo = LANG_GEO[n.langId];
    return { ...n, geo, ...projectGeo(geo) };
  });
const byId = new Map(placed.map((p) => [p.id, p]));
const arcs = edges
  .filter((e) => byId.has(e.from) && byId.has(e.to))
  .map((e) => {
    const a = byId.get(e.from)!;
    const b = byId.get(e.to)!;
    // Quadratic arc bowed to the left of travel, so parallel routes separate.
    const cx = (a.x + b.x) / 2 - (b.y - a.y) * 0.18;
    const cy = (a.y + b.y) / 2 + (b.x - a.x) * 0.18;
    return { d: `M${a.x.toFixed(1)},${a.y.toFixed(1)}Q${cx.toFixed(1)},${cy.toFixed(1)} ${b.x.toFixed(1)},${b.y.toFixed(1)}`, start: b.start };
  });
const minYear = Math.min(...placed.map((p) => p.start));
const maxYear = Math.max(...placed.map((p) => p.end));
const fmtYear = (y: number) => (y < 0 ? `${-y} BCE` : y === 0 ? '1 CE' : `${y} CE`);
---

<div class="tmap-wrap">
  <svg class="tmap-svg" viewBox={COAST_VIEWBOX} role="img" aria-label={`Map of the names' homelands and transmission paths`}>
    <path class="coast" d={COAST_PATH} />
    {arcs.map((arc) => (
      <path class="arc" d={arc.d} pathLength="1" data-start={arc.start} />
    ))}
    {placed.map((p) => (
      <a href={`#${p.anchor}`} class="map-node" data-start={p.start}>
        <title>{p.langName} · {p.translit} · {p.geo.place} · {formatEra(p.start, p.end)}</title>
        <circle cx={p.x} cy={p.y} r="3.2" />
        {p.geo.offmap && <text class="offmark" x={p.x + 6} y={p.y + 3.5}>→</text>}
        <text
          class="map-label"
          x={p.x + (p.geo.dx ?? 7)}
          y={p.y + (p.geo.dy ?? 3.5)}
          text-anchor={p.geo.anchor ?? 'start'}
        >{p.translit}</text>
      </a>
    ))}
  </svg>
</div>
<div class="tmap-controls">
  <label class="tmap-label" for={`era-${civId}`}>Attested by</label>
  <input id={`era-${civId}`} class="tmap-range" type="range" min={minYear} max={maxYear} step="10" value={maxYear} />
  <output class="tmap-year" for={`era-${civId}`}>{fmtYear(maxYear)}</output>
</div>

<script>
  for (const wrap of document.querySelectorAll('.tmap-controls')) {
    const range = wrap.querySelector<HTMLInputElement>('.tmap-range')!;
    const year = wrap.querySelector('.tmap-year')!;
    const svg = wrap.previousElementSibling!.querySelector('svg')!;
    const dated = svg.querySelectorAll<SVGElement>('[data-start]');
    const fmt = (y: number) => (y < 0 ? `${-y} BCE` : y === 0 ? '1 CE' : `${y} CE`);
    range.addEventListener('input', () => {
      const v = Number(range.value);
      year.textContent = fmt(v);
      for (const el of dated) el.classList.toggle('off', Number(el.dataset.start) > v);
    });
  }
</script>

<style>
  .tmap-wrap { overflow-x: auto; margin: 1.5rem 0 0.5rem; }
  .tmap-svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: color-mix(in srgb, var(--ink) 2%, var(--parchment));
  }
  .coast {
    fill: color-mix(in srgb, var(--ink) 6%, var(--parchment));
    stroke: var(--rule);
    stroke-width: 0.8;
  }
  .arc {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.2;
    opacity: 0.55;
    transition: opacity 0.3s;
  }
  .map-node circle {
    fill: var(--accent);
    transition: opacity 0.3s;
  }
  .map-node text {
    font-family: 'EB Garamond', Georgia, serif;
    font-style: italic;
    font-size: 12.5px;
    fill: var(--ink);
    transition: opacity 0.3s;
  }
  .map-node .offmark { font-style: normal; fill: var(--ink-soft); }
  .map-node:hover circle, .map-node:focus circle { r: 4.5; }
  .map-node:hover text, .map-node:focus text { fill: var(--accent); }
  .arc.off, .map-node.off { opacity: 0.1; }
  .map-node.off { pointer-events: none; }
  /* Draw the arcs in when the section scrolls into view (script-opted). */
  @media (prefers-reduced-motion: no-preference) {
    :global(.tmap.anim) .arc {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }
    :global(.tmap.anim.revealed) .arc {
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 1.1s ease 0.15s, opacity 0.3s;
    }
  }
  .tmap-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 2rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }
  .tmap-range { flex: 1; accent-color: var(--accent); }
  .tmap-year { min-width: 5.5em; text-align: right; font-variant-numeric: tabular-nums; }
</style>
