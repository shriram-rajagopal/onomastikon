---
// A small floating "?" on the right edge that pops out a quick legend for the
// current page. Content comes through the slot; the button, panel, wiring,
// and diagram styles live here so both the homepage and the entity pages
// present the same affordance.
interface Props {
  title: string;
  /** One-time "First time here?" scroll callout pointing at the button (homepage). */
  callout?: boolean;
}
const { title, callout = false } = Astro.props;
---

<button class="help-btn" id="help-btn" type="button" aria-expanded="false" aria-controls="help-panel" aria-label="What am I looking at? Open the reading help panel" title="What am I looking at?">?</button>
{callout && (
  <div class="help-callout" id="help-callout" hidden aria-hidden="true">
    <svg class="ca-svg" viewBox="0 0 40 60" width="40" height="60" aria-hidden="true" focusable="false">
      <path class="ca-line" d="M23 57 C 6 45, 36 26, 20 8" pathLength="1" />
      <path class="ca-head" d="M13 16 L20 5 L28 13" />
    </svg>
    <span class="ca-text">First time here?</span>
  </div>
)}
{/* The title is a styled paragraph, not a heading: the panel sits above the
    page's <h1> in DOM order, and a heading here would break heading order
    for assistive tech whenever the panel is open. The dialog is labelled by
    it via aria-labelledby instead. */}
<aside class="help-panel corner-ticks" id="help-panel" role="dialog" aria-modal="true" aria-labelledby="help-title" tabindex="-1" hidden>
  <p class="help-title" id="help-title">{title}</p>
  <slot />
</aside>

<script>
  const btn = document.getElementById('help-btn');
  const panel = document.getElementById('help-panel');
  if (btn && panel) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      btn.classList.toggle('open', open);
      // Dialog focus contract: focus moves into the panel on open and back
      // to the button on close.
      if (open) panel.focus();
      else btn.focus();
    };
    btn.addEventListener('click', () => setOpen(panel.hidden));
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) setOpen(false);
    });
    // Focus trap while the dialog is open: Tab cycles through the panel and
    // its opener rather than escaping into the page beneath.
    addEventListener('keydown', (e) => {
      if (e.key !== 'Tab' || panel.hidden) return;
      const focusables = [
        panel,
        ...panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
        btn,
      ];
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      const active = document.activeElement;
      if (e.shiftKey && active === first) {
        e.preventDefault();
        (last as HTMLElement).focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        (first as HTMLElement).focus();
      } else if (active && !focusables.includes(active as HTMLElement)) {
        e.preventDefault();
        (first as HTMLElement).focus();
      }
    });
    addEventListener('pointerdown', (e) => {
      if (!panel.hidden && !panel.contains(e.target as Node) && e.target !== btn) {
        panel.hidden = true;
        btn.setAttribute('aria-expanded', 'false');
        btn.classList.remove('open');
      }
    });
  }

  // One-time scroll callout: once the visitor scrolls into the page, point
  // them at the help button. Shows once per browser (localStorage), retires
  // itself on any interaction with the button or after a few seconds.
  const callout = document.getElementById('help-callout');
  if (callout && btn) {
    const KEY = 'onk-help-callout-shown';
    let seen = false;
    try { seen = !!localStorage.getItem(KEY); } catch { /* private mode: show */ }
    const dismiss = () => {
      btn.classList.remove('beckon');
      if (!callout.hidden) {
        callout.classList.add('off');
        setTimeout(() => callout.remove(), 450);
      } else {
        callout.remove();
      }
    };
    if (seen) {
      callout.remove();
    } else {
      let shown = false;
      const onScroll = () => {
        if (shown || scrollY < 240) return;
        shown = true;
        removeEventListener('scroll', onScroll);
        callout.hidden = false;
        requestAnimationFrame(() => {
          callout.classList.add('on');
          btn.classList.add('beckon');
        });
        try { localStorage.setItem(KEY, '1'); } catch { /* fine */ }
        setTimeout(dismiss, 10000);
      };
      addEventListener('scroll', onScroll, { passive: true });
      btn.addEventListener('click', dismiss, { once: true });
    }
  }
</script>

<style>
  /* Sits in the left gutter, beneath where the homepage's Browse rail ends,
     and holds the identical spot on entity pages so it never moves as the
     reader navigates. Falls back to the top-right corner when the gutter
     goes away. */
  .help-btn {
    position: fixed;
    left: calc((100vw - var(--max-width)) / 2 - 14.5rem);
    top: 21rem;
    z-index: 25;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    border: 1px solid var(--rule-strong);
    background: var(--parchment);
    color: var(--accent);
    font-family: 'EB Garamond', Georgia, serif;
    font-size: 1.4rem;
    font-weight: 600;
    cursor: pointer;
    box-shadow: var(--shadow-soft);
  }
  .help-btn:hover, .help-btn.open { border-color: var(--accent); box-shadow: var(--shadow-lift); }

  /* "First time here?" scroll callout: an arrow drawing itself up to the
     button with a hand-note caption beneath. Centered under the button in
     the desktop gutter, right-anchored under it on narrow screens. */
  .help-callout {
    position: fixed;
    left: calc((100vw - var(--max-width)) / 2 - 14.5rem);
    /* Below the share button, which took the slot directly under the help
       button; the arrow still points up at the control stack. */
    top: 27.4rem;
    z-index: 24;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.1rem;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }
  .help-callout.off { opacity: 0; }
  .ca-svg { display: block; overflow: visible; }
  .ca-line, .ca-head {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ca-line { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .ca-head { opacity: 0; }
  .ca-text {
    font-family: 'EB Garamond', Georgia, serif;
    font-style: italic;
    font-weight: 600;
    font-size: 1.3rem;
    color: var(--accent);
    white-space: nowrap;
    transform: rotate(-3deg) translateY(10px) scale(0.9);
    opacity: 0;
    text-shadow: 0 1px 0 var(--parchment);
  }
  .help-callout.on .ca-line { animation: ca-draw 0.8s ease 0.35s forwards; }
  .help-callout.on .ca-head { animation: ca-appear 0.25s ease 1.05s forwards; }
  .help-callout.on .ca-text { animation: ca-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards; }
  .help-btn.beckon { animation: ca-beckon 1.7s ease-out 0.9s 3; }
  @keyframes ca-draw { to { stroke-dashoffset: 0; } }
  @keyframes ca-appear { to { opacity: 1; } }
  @keyframes ca-pop { to { transform: rotate(-3deg) translateY(0) scale(1); opacity: 1; } }
  @keyframes ca-beckon {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 55%, transparent); }
    70% { box-shadow: 0 0 0 14px color-mix(in srgb, var(--accent) 0%, transparent); }
    100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 0%, transparent); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ca-line { stroke-dasharray: none; stroke-dashoffset: 0; }
    .help-callout.on .ca-head { animation: none; opacity: 1; }
    .help-callout.on .ca-text { animation: none; transform: rotate(-3deg); opacity: 1; }
    .help-btn.beckon { animation: none; }
  }
  .help-panel {
    position: fixed;
    left: calc((100vw - var(--max-width)) / 2 - 14.5rem);
    top: 24.2rem;
    z-index: 25;
    width: min(330px, calc(100vw - 2.2rem));
    max-height: min(30rem, calc(100vh - 26rem));
    overflow-y: auto;
    background-color: color-mix(in srgb, var(--ink) 2%, var(--parchment));
    background-image: var(--grain);
    border: 1px solid var(--rule-strong);
    border-radius: 6px;
    box-shadow: var(--shadow-lift);
    padding: 1rem 1.15rem 1.1rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--ink);
  }
  @media (prefers-reduced-motion: no-preference) {
    .help-panel { animation: help-pop 0.2s ease; }
  }
  @keyframes help-pop {
    from { opacity: 0; transform: translateY(-6px); }
  }
  .help-panel:focus { outline: none; }
  .help-panel:focus-visible { border-color: var(--accent); }
  .help-title {
    margin: 0 0 0.6rem;
    font-family: 'EB Garamond', Georgia, serif;
    font-size: 1.1rem;
    font-weight: 700;
  }
  .help-panel :global(ul) { margin: 0.5rem 0 0; padding-left: 1.1rem; }
  .help-panel :global(li) { margin: 0.35rem 0; }
  .help-panel :global(p) { margin: 0.5rem 0; }
  /* The mini diagram: a mock index row with legend chips beneath. */
  .help-panel :global(.hd-row) {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 0.45rem 0.6rem;
    margin: 0.6rem 0 0.35rem;
    font-family: 'EB Garamond', Georgia, serif;
    font-size: 0.9375rem;
  }
  .help-panel :global(.hd-era) { margin-left: auto; font-family: 'Inter', sans-serif; font-size: 0.6875rem; color: var(--ink-soft); }
  .help-panel :global(.hd-chip) {
    font-family: 'Inter', sans-serif;
    font-size: 0.625rem;
    font-weight: 600;
    padding: 0 0.4rem;
    border-radius: 999px;
  }
  .help-panel :global(.hd-green) { background: var(--badge-complete-bg); color: var(--badge-complete-fg); }
  .help-panel :global(.hd-blue) { background: var(--badge-developing-bg); color: var(--badge-developing-fg); }
  .help-panel :global(.hd-tree) {
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 0.45rem 0.6rem;
    margin: 0.6rem 0 0.35rem;
    font-size: 0.75rem;
  }
  .help-panel :global(.hd-tree div + div) { padding-left: 1.1rem; border-left: 2px solid var(--rule-strong); margin-left: 0.3rem; }
  @media (max-width: 1200px) {
    /* 8.2rem clears the header now that the search bar rides inside it. */
    .help-btn { left: auto; right: 1.1rem; top: 8.2rem; width: 1.9rem; height: 1.9rem; font-size: 1.05rem; }
    .help-panel { left: auto; right: 1.1rem; top: 10.6rem; max-height: min(34rem, calc(100vh - 12rem)); }
    .help-callout { left: auto; right: 0.8rem; top: 12.8rem; align-items: flex-end; }
    .ca-svg { margin-right: 0.55rem; }
  }
  @media print {
    .help-btn, .help-panel, .help-callout { display: none; }
  }
</style>
