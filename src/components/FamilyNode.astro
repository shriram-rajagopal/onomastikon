---
// One node in a transmission-chain tree, recursing into the forms derived
// from it. Pure HTML/CSS: the connecting lines are drawn with borders, so the
// diagram needs no script and inherits both themes from the CSS variables.
import { entryAnchor } from '../lib/entry';

export interface TreeNode {
  id: string;
  original_text: string;
  transliteration: string;
  languageName: string;
  langCode?: string;
  rtl?: boolean;
  children: TreeNode[];
}

interface Props {
  node: TreeNode;
  civId: string;
}
const { node, civId } = Astro.props;
---

<li class="family-node">
  <a class="node-card" href={`#${entryAnchor(node.id, civId)}`}>
    {node.original_text && (
      <span class="node-original" lang={node.langCode} dir={node.rtl ? 'rtl' : undefined}>{node.original_text}</span>
    )}
    <span class="node-translit"><em>{node.transliteration}</em></span>
    <span class="node-lang">{node.languageName}</span>
  </a>
  {node.children.length > 0 && (
    <ul class="family-children">
      {node.children.map((child) => <Astro.self node={child} civId={civId} />)}
    </ul>
  )}
</li>

<style>
  .family-node {
    list-style: none;
    position: relative;
    margin: 0.5rem 0;
  }
  .node-card {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: color-mix(in srgb, var(--ink) 3%, var(--parchment));
    text-decoration: none;
    color: var(--ink);
  }
  .node-card:hover { border-color: var(--accent); color: var(--accent); }
  .node-original {
    font-family: 'EB Garamond', 'Noto Sans Egyptian Hieroglyphs', 'Noto Sans Cuneiform', 'Noto Sans Old Persian', 'Noto Sans Avestan', 'Noto Serif Devanagari', 'Noto Serif Hebrew', 'Noto Naskh Arabic', 'Noto Sans Coptic', 'Noto Sans Ethiopic', 'Noto Sans Inscriptional Pahlavi', 'Noto Sans Inscriptional Parthian', 'Noto Sans Manichaean', 'Noto Sans Syriac', 'Noto Sans Phoenician', 'Noto Sans Ugaritic', 'Noto Sans Lycian', 'Noto Sans Old Italic', 'Noto Sans Linear B', serif;
    font-size: 1.2rem;
    line-height: 1.2;
  }
  .node-translit { font-size: 1rem; }
  .node-lang {
    font-family: 'Inter', sans-serif;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-soft);
  }
  /* Children hang from a left rail; each child gets a short horizontal tick
     joining it to the rail, reading as "descends from the node above". */
  .family-children {
    margin: 0.25rem 0 0;
    padding: 0 0 0 1.6rem;
    border-left: 1px solid var(--rule);
    margin-left: 1rem;
  }
  .family-children > :global(.family-node)::before {
    content: '';
    position: absolute;
    left: -1.6rem;
    top: 1.1rem;
    width: 1.1rem;
    border-top: 1px solid var(--rule);
  }
  /* Scroll reveal: nodes are hidden only after the page script opts the
     section in (.anim), so the no-JS and reduced-motion paths always see the
     full tree. The per-node stagger delay is set by the script. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.family.anim) .family-node {
      opacity: 0;
      transform: translateY(8px);
    }
    :global(.family.anim.revealed) .family-node {
      opacity: 1;
      transform: none;
      transition:
        opacity 0.5s ease var(--reveal-delay, 0s),
        transform 0.5s ease var(--reveal-delay, 0s);
    }
  }
  /* Lineage trace: hovering or focusing a form lights its ancestor cards and
     the rails connecting them, reading the chain back to its root. */
  .node-card.lit {
    border-color: var(--accent);
    color: var(--accent);
  }
  .family-children.lit {
    border-left-color: var(--accent);
  }
  .family-children.lit > :global(.family-node)::before {
    border-top-color: var(--accent);
  }
</style>
