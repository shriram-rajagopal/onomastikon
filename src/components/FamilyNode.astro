---
// One node in a transmission-chain tree, recursing into the forms derived
// from it. Pure HTML/CSS: the connecting lines are drawn with borders, so the
// diagram needs no script and inherits both themes from the CSS variables.
// Solid rails mean an asserted borrowing (a derived_from edge in the data);
// the dashed rail that groups parallel roots is drawn by the page, not here.
import { entryAnchor } from '../lib/entry';

export interface TreeNode {
  id: string;
  original_text: string;
  transliteration: string;
  languageName: string;
  langCode?: string;
  rtl?: boolean;
  era?: string;
  /* Set on a "ghost" parent: a form on another entity's page that this
     page's forms were borrowed from. The card links there instead of to a
     local anchor and is drawn dashed to mark it as off-page context. */
  externalHref?: string;
  externalNote?: string;
  children: TreeNode[];
}

interface Props {
  node: TreeNode;
  civId: string;
}
const { node, civId } = Astro.props;
---

<li class="family-node">
  <a
    class:list={['node-card', { 'node-ghost': !!node.externalHref }]}
    href={node.externalHref ?? `#${entryAnchor(node.id, civId)}`}
  >
    {node.original_text && (
      <span class="node-original" lang={node.langCode} dir={node.rtl ? 'rtl' : undefined}>{node.original_text}</span>
    )}
    <span class="node-main">
      <span class="node-translit"><em>{node.transliteration}</em></span>
      <span class="node-lang">{node.languageName}{node.era && <span class="node-era"> · {node.era}</span>}{node.externalNote && <span class="node-where"> · {node.externalNote} ↗</span>}</span>
    </span>
  </a>
  {node.children.length > 0 && (
    <ul class="family-children">
      {node.children.map((child) => <Astro.self node={child} civId={civId} />)}
    </ul>
  )}
</li>

<style>
  .family-node {
    list-style: none;
    position: relative;
    margin: 0.5rem 0;
  }
  .node-card {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--rule-strong);
    border-radius: 6px;
    background: color-mix(in srgb, var(--ink) 3%, var(--parchment));
    box-shadow: var(--shadow-soft);
    text-decoration: none;
    color: var(--ink);
    max-width: 100%;
  }
  .node-card:hover { border-color: var(--accent); color: var(--accent); }
  .node-original {
    font-family: 'EB Garamond', 'Noto Sans Egyptian Hieroglyphs', 'Noto Sans Cuneiform', 'Noto Sans Old Persian', 'Noto Sans Avestan', 'Noto Serif Devanagari', 'Noto Serif Hebrew', 'Noto Naskh Arabic', 'Noto Sans Coptic', 'Noto Sans Ethiopic', 'Noto Sans Inscriptional Pahlavi', 'Noto Sans Inscriptional Parthian', 'Noto Sans Manichaean', 'Noto Sans Syriac', 'Noto Sans Phoenician', 'Noto Sans Ugaritic', 'Noto Sans Lycian', 'Noto Serif Armenian', 'Noto Sans Old Italic', 'Noto Sans Linear B', serif;
    font-size: 1.2rem;
    line-height: 1.2;
  }
  /* Transliteration above, language + era below: the card reads as a small
     lexicon lemma instead of a single crowded line. */
  .node-main { display: flex; flex-direction: column; gap: 0.05rem; min-width: 0; }
  .node-translit { font-size: 1rem; line-height: 1.25; }
  .node-lang {
    font-family: 'Inter', sans-serif;
    font-size: 0.6563rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-soft);
    white-space: nowrap;
  }
  .node-era { text-transform: none; letter-spacing: 0.02em; }
  /* Ghost card: the off-page source a chain hangs from. Dashed and unfilled,
     it reads as context rather than one of this page's entries. */
  .node-ghost {
    border-style: dashed;
    background: transparent;
    box-shadow: none;
  }
  .node-where { color: var(--accent); letter-spacing: 0.02em; }
  /* Children hang from a left rail; each child gets a horizontal tick joining
     it to the rail. Solid lines are the meaningful mark: this form was
     borrowed from the one it hangs under. The rail is drawn per child (not as
     a border on the list) so it emerges from under the parent card, runs
     child to child, and STOPS at the last child's elbow instead of dangling
     past it; ticks span the full gutter so they touch the cards they join. */
  .family-children {
    margin: 0.25rem 0 0;
    padding: 0 0 0 1.6rem;
    margin-left: 1.1rem;
  }
  .family-children > :global(.family-node)::before {
    content: '';
    position: absolute;
    left: -1.6rem;
    top: 1.35rem;
    width: 1.6rem;
    border-top: 1.5px solid var(--rule-strong);
  }
  .family-children > :global(.family-node)::after {
    content: '';
    position: absolute;
    left: -1.6rem;
    top: -0.75rem;
    bottom: 0;
    border-left: 1.5px solid var(--rule-strong);
  }
  .family-children > :global(.family-node):last-child::after {
    bottom: auto;
    height: 2.1rem;
  }
  /* Scroll reveal: nodes are hidden only after the page script opts the
     section in (.anim), so the no-JS and reduced-motion paths always see the
     full tree. The per-node stagger delay is set by the script. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.family.anim) .family-node {
      opacity: 0;
      transform: translateY(8px);
    }
    :global(.family.anim.revealed) .family-node {
      opacity: 1;
      transform: none;
      transition:
        opacity 0.5s ease var(--reveal-delay, 0s),
        transform 0.5s ease var(--reveal-delay, 0s);
    }
  }
  /* Lineage trace: hovering or focusing a form lights its ancestor cards and
     the rails connecting them, reading the chain back to its root. */
  .node-card.lit {
    border-color: var(--accent);
    color: var(--accent);
  }
  .family-children.lit > :global(.family-node)::before {
    border-top-color: var(--accent);
  }
  .family-children.lit > :global(.family-node)::after {
    border-left-color: var(--accent);
  }
</style>
