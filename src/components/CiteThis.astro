---
// "Cite this page/entry" block: a Chicago-style citation line and a BibTeX
// record, each with a copy button. The full variant is the page-level block;
// the compact variant sits inside a name entry's Sources drawer, citing the
// entry's permalink anchor, with the BibTeX present but not displayed.
// The author line is the project's author; the year is the content's
// last-modified year when known, else the build year (entries carry their
// own source citations separately).
import { formatFullDate } from '../lib/dates';

interface Props {
  title: string;
  path: string;
  /** Entry anchor; when set, the citation points at path#anchor. */
  anchor?: string;
  /** Render the compact in-drawer variant instead of the page-level section. */
  compact?: boolean;
  /** Content's last-modified date (YYYY-MM-DD); adds the Chicago
      "Last modified" clause and pins the BibTeX year. */
  modified?: string;
}
const { title, path, anchor, compact = false, modified } = Astro.props;
const url = new URL(anchor ? `${path}#${anchor}` : path, Astro.site).href;
const year = modified ? Number(modified.slice(0, 4)) : new Date().getFullYear();
const lastModified = modified ? `Last modified ${formatFullDate(modified)}. ` : '';
const slug = [path.split('/').filter(Boolean).pop(), anchor].filter(Boolean).join('-');
const base = `cite-${slug}`;
const bibtex = `@misc{onomastikon-${slug},
  author = {Rajagopal, Shriram},
  title = {${title}},
  year = {${year}},
  howpublished = {\\url{${url}}},
  note = {Onomastikon: A Digital Atlas of Ancient Names}
}`;
---

{compact ? (
  <details class="cite-entry">
    <summary>Cite this entry</summary>
    <p class="cite-chicago" id={`${base}-chicago`}>
      Rajagopal, Shriram. "{title}." <em>Onomastikon: A Digital Atlas of Ancient Names</em>. {lastModified}{url}.
    </p>
    <span hidden id={`${base}-bibtex`}>{bibtex}</span>
    <p class="cite-actions">
      <button type="button" data-copy={`${base}-chicago`}>Copy citation</button>
      <button type="button" data-copy={`${base}-bibtex`}>Copy BibTeX</button>
    </p>
  </details>
) : (
  <section class="cite" id="cite">
    <h2>Cite this page</h2>
    <p class="cite-chicago" id={`${base}-chicago`}>
      Rajagopal, Shriram. "{title}." <em>Onomastikon: A Digital Atlas of Ancient Names</em>. {lastModified}{url}.
    </p>
    <pre class="cite-bibtex" id={`${base}-bibtex`}>{bibtex}</pre>
    <p class="cite-actions">
      <button type="button" data-copy={`${base}-chicago`}>Copy citation</button>
      <button type="button" data-copy={`${base}-bibtex`}>Copy BibTeX</button>
    </p>
  </section>
)}

<script>
  // Clipboard API first; fall back to a transient textarea + execCommand for
  // contexts where the permission is denied. Always give visible feedback.
  function copyText(text: string): boolean {
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.append(ta);
    ta.select();
    let ok = false;
    try { ok = document.execCommand('copy'); } catch { ok = false; }
    ta.remove();
    return ok;
  }
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    btn.addEventListener('click', async () => {
      const el = document.getElementById(btn.dataset.copy!);
      if (!el) return;
      const text = el.textContent!.trim();
      let ok = true;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        ok = copyText(text);
      }
      const old = btn.textContent;
      btn.textContent = ok ? 'Copied' : 'Copy failed';
      setTimeout(() => { btn.textContent = old; }, 1500);
    });
  }
</script>

<style>
  .cite { margin-top: 3rem; }
  .cite-chicago { font-size: 1rem; color: var(--ink-soft); }
  .cite-bibtex {
    font-size: 0.8125rem;
    line-height: 1.5;
    padding: 0.75rem 1rem;
    background: color-mix(in srgb, var(--ink) 4%, var(--parchment));
    border: 1px solid var(--rule);
    border-radius: 4px;
    overflow-x: auto;
    color: var(--ink-soft);
  }
  .cite-actions { display: flex; gap: 0.75rem; margin: 0.5rem 0 0; }
  .cite-actions button {
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    padding: 0.3rem 0.8rem;
    background: var(--parchment);
    color: var(--ink-soft);
    border: 1px solid var(--rule);
    border-radius: 4px;
    cursor: pointer;
  }
  .cite-actions button:hover { color: var(--accent); border-color: var(--accent); }
  /* Compact per-entry variant: a standalone collapsed drawer that sits beside
     the Sources drawer, so an entry can be cited without opening our sources. */
  .cite-entry { margin-top: 0.5rem; }
  .cite-entry summary {
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    color: var(--ink-soft);
    cursor: pointer;
  }
  .cite-entry summary:hover { color: var(--accent); }
  .cite-entry .cite-chicago {
    font-size: 0.875rem;
    margin: 0.75rem 0 0;
    overflow-wrap: anywhere;
  }
  .cite-entry .cite-actions button { font-size: 0.75rem; padding: 0.2rem 0.6rem; }
</style>
