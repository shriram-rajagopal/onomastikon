---
interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Optional schema.org JSON-LD object, serialized into the head. */
  schema?: Record<string, unknown>;
}
const { title, description, image, schema } = Astro.props;

// Public-facing text is authored, never synthesized here: the description is an
// entity's own summary (passed in) or the site tagline. The OG image is the
// page's title card when it has one, otherwise the site-wide fallback card.
const metaDescription = description ?? 'A digital atlas of ancient names.';
const pageTitle = `${title} — Onomastikon`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL(image ?? '/og-default.png', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <meta name="theme-color" content="#f5efe4" />
    <!-- Theme boot: set data-theme before first paint so a stored or system
         dark preference never flashes parchment. Kept inline and tiny. -->
    <script is:inline>
      (() => {
        let t = null;
        try { t = localStorage.getItem('theme'); } catch {}
        if (t !== 'dark' && t !== 'light') {
          t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = t;
        if (t === 'dark') {
          const m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', '#211e18');
        }
      })();
    </script>
    <!-- View-transition pairing. Static view-transition-names scatter: any
         named element without a match on the destination page exits as its
         own floating layer. Instead, tag exactly one element per side, per
         navigation, and only for the clean pair (an index row and the detail
         page's h1, same text and font). Must run from the head so the
         pagereveal listener is registered before first render. -->
    <script is:inline>
      (() => {
        const NAME = 'detail-title';
        const detail = (path) => {
          const m = path.match(/^\/(civilizations|languages)\/([a-z0-9-]+)\/?$/);
          return m ? `${m[1]}/${m[2]}` : null;
        };
        const isIndex = (path) => path === '/' || path === '/index.html';
        const clear = () => {
          for (const el of document.querySelectorAll('[style*="view-transition-name"]')) {
            if (el.style.viewTransitionName === NAME) el.style.viewTransitionName = '';
          }
        };
        const tagRow = (slug) => {
          const el = slug && document.querySelector(`[data-morph="${slug}"]`);
          if (el) el.style.viewTransitionName = NAME;
        };
        const tagH1 = () => {
          const h1 = document.querySelector('main h1');
          if (h1) h1.style.viewTransitionName = NAME;
        };
        addEventListener('pageswap', (e) => {
          if (!e.viewTransition || !e.activation) return;
          const here = location.pathname;
          const to = new URL(e.activation.entry.url).pathname;
          if (isIndex(here) && detail(to)) tagRow(detail(to));
          else if (detail(here) && isIndex(to)) tagH1();
        });
        addEventListener('pagereveal', (e) => {
          clear();
          if (!e.viewTransition || !window.navigation?.activation?.from) return;
          const from = new URL(navigation.activation.from.url).pathname;
          const here = location.pathname;
          if (detail(here) && isIndex(from)) tagH1();
          else if (isIndex(here) && detail(from)) tagRow(detail(from));
          e.viewTransition.finished.finally(clear);
        });
      })();
    </script>
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <!-- Open Graph / Twitter social previews. Description mirrors the page's
         authored summary; image is the entity title card or the fallback. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Onomastikon" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="720" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,600;1,400&family=Inter:wght@400;600&family=Noto+Sans+Egyptian+Hieroglyphs&family=Noto+Sans+Old+Persian&family=Noto+Sans+Avestan&family=Noto+Sans+Cuneiform&family=Noto+Serif+Devanagari&family=Noto+Serif+Hebrew&family=Noto+Naskh+Arabic&family=Noto+Sans+Coptic&family=Noto+Sans+Ethiopic&family=Noto+Sans+Inscriptional+Pahlavi&family=Noto+Sans+Inscriptional+Parthian&family=Noto+Sans+Manichaean&family=Noto+Sans+Syriac&family=Noto+Sans+Phoenician&family=Noto+Sans+Ugaritic&family=Noto+Sans+Old+Italic&family=Noto+Sans+Linear+B&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a href="/" class="logo">Onomastikon</a>
      <nav>
        <a href="/search">Search</a>
        <a href="/about">About</a>
        <button id="theme-toggle" type="button">◐ Dark mode</button>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        Onomastikon · A digital atlas of ancient names ·
        <a href="/onomastikon.json">Data</a> ·
        <a href="https://github.com/shriram-rajagopal/onomastikon">GitHub</a> ·
        <a href="/feedback" id="site-feedback">Feedback</a>
      </p>
    </footer>

    <style is:global>
      :root {
        --parchment: #f5efe4;
        --ink: #1a1a1a;
        --ink-soft: #4a4a4a;
        --rule: #d8cfbf;
        --accent: #6b3a2a;
        --max-width: 720px;
        --badge-developing-bg: #d9e2ec; --badge-developing-fg: #334e68;
        --badge-complete-bg: #d8e7d6; --badge-complete-fg: #2c5a3a;
        --conf-attested-bg: #e3edd9; --conf-attested-fg: #3a5a1c;
        --conf-reconstructed-bg: #f0e5d0; --conf-reconstructed-fg: #6b4f1c;
        --conf-disputed-bg: #f0d8d0; --conf-disputed-fg: #7a3020;
        color-scheme: light;
      }
      /* Dark theme: the same lamplit-study identity with the values inverted.
         Every text/background pairing here was checked against WCAG AA
         (all clear 6.1:1 or better, matching the light palette's profile). */
      :root[data-theme='dark'] {
        --parchment: #211e18;
        --ink: #ece5d8;
        --ink-soft: #b8b0a2;
        --rule: #403a30;
        --accent: #d29978;
        --badge-developing-bg: #2c3a47; --badge-developing-fg: #b9d2e8;
        --badge-complete-bg: #2b3b2b; --badge-complete-fg: #b4d6bc;
        --conf-attested-bg: #313f2a; --conf-attested-fg: #bfd9a3;
        --conf-reconstructed-bg: #403729; --conf-reconstructed-fg: #e0c596;
        --conf-disputed-bg: #422c26; --conf-disputed-fg: #e2ab90;
        color-scheme: dark;
      }
      /* Title cards and the masthead are ink-on-transparent renders authored for
         parchment; invert-plus-hue-rotate re-aims them at the dark ground while
         keeping the warm accent warm. */
      :root[data-theme='dark'] .featured,
      :root[data-theme='dark'] .masthead-motion,
      :root[data-theme='dark'] .masthead-static {
        filter: invert(0.88) hue-rotate(180deg);
      }
      /* The masthead's parchment CSS backdrop would invert to a light plate;
         drop it in dark mode so the filtered glyphs sit on the page ground.
         (Transparent pixels stay transparent under filter.) */
      :root[data-theme='dark'] .masthead-motion,
      :root[data-theme='dark'] .masthead-static {
        background: transparent;
      }
      * { box-sizing: border-box; }
      html { background: var(--parchment); color: var(--ink); scroll-behavior: smooth; }
      /* Cross-document view transitions: same-origin navigations cross-fade,
         and elements sharing a view-transition-name (entity and language
         names) morph between pages. Pure CSS; browsers without support, and
         visitors preferring reduced motion, get instant navigation. */
      @media (prefers-reduced-motion: no-preference) {
        @view-transition {
          navigation: auto;
        }
      }
      /* Page chrome is identical across pages; naming it keeps it stable
         while the content cross-fades beneath. */
      .site-header { view-transition-name: site-header; }
      .site-footer { view-transition-name: site-footer; }
      /* The morphing title pair scales proportionally instead of stretching
         to the group box (the sizes differ between row text and h1). */
      ::view-transition-old(detail-title),
      ::view-transition-new(detail-title) {
        height: 100%;
        width: auto;
      }
      /* Keyboard focus: a consistent, clearly visible ring in the accent color.
         :focus-visible keeps it off mouse clicks. */
      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }
      /* Skip link: visually hidden until focused, then pinned at the top. */
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 10;
        padding: 0.5rem 1rem;
        background: var(--parchment);
        color: var(--accent);
        font-family: 'Inter', sans-serif;
        font-size: 0.875rem;
        border: 1px solid var(--rule);
      }
      .skip-link:focus {
        left: 1rem;
      }
      /* Honor reduced-motion: jump instantly to hash anchors instead of animating. */
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
      }
      body {
        margin: 0;
        font-family: 'EB Garamond', Georgia, serif;
        font-size: 1.125rem;
        line-height: 1.6;
      }
      .site-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 2rem 1.5rem 1rem;
        border-bottom: 1px solid var(--rule);
      }
      .logo {
        font-size: 1.5rem;
        font-weight: 600;
        text-decoration: none;
        color: var(--ink);
        letter-spacing: 0.02em;
      }
      .site-header nav { font-family: 'Inter', sans-serif; font-size: 0.875rem; }
      .site-header nav a {
        margin-left: 1.5rem;
        text-decoration: none;
        color: var(--ink-soft);
      }
      .site-header nav a:hover { color: var(--accent); }
      #theme-toggle {
        margin-left: 1.5rem;
        padding: 0;
        background: none;
        border: none;
        cursor: pointer;
        font-family: 'Inter', sans-serif;
        font-size: 0.875rem;
        line-height: 1;
        color: var(--ink-soft);
      }
      #theme-toggle:hover { color: var(--accent); }
      main {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 2rem 1.5rem 4rem;
      }
      .site-footer {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 2rem 1.5rem;
        border-top: 1px solid var(--rule);
        font-family: 'Inter', sans-serif;
        font-size: 0.8125rem;
        color: var(--ink-soft);
      }
      /* When a top-of-page "send feedback" note jumps here, mark the footer
         Feedback link so the reader sees where to act. Mirrors the entry
         permalink highlight; the flash is motion-gated, the outline persists. */
      #site-feedback { scroll-margin: 3rem; border-radius: 3px; }
      #site-feedback:target { outline: 2px solid var(--accent); outline-offset: 3px; color: var(--accent); }
      @media (prefers-reduced-motion: no-preference) {
        #site-feedback:target { animation: feedback-flash 2s ease-out; }
      }
      @keyframes feedback-flash {
        0%, 45% { background: color-mix(in srgb, var(--accent) 22%, var(--parchment)); }
        100% { background: transparent; }
      }
      h1, h2, h3 { font-weight: 600; letter-spacing: -0.01em; }
      h1 { font-size: 2.5rem; margin: 0 0 0.25rem; }
      h2 { font-size: 1.5rem; margin: 2.5rem 0 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--rule); }
      a { color: var(--accent); }
      @media print {
        .skip-link, .site-header nav { display: none; }
        /* Force the light palette on paper regardless of the on-screen theme,
           and drop the dark-mode image inversion. */
        :root, :root[data-theme='dark'] {
          --parchment: #f5efe4;
          --ink: #1a1a1a;
          --ink-soft: #4a4a4a;
          --rule: #d8cfbf;
          --accent: #6b3a2a;
        }
        :root[data-theme='dark'] .featured,
        :root[data-theme='dark'] .masthead-motion,
        :root[data-theme='dark'] .masthead-static { filter: none; }
        /* Most browsers omit backgrounds when printing; keep text plain ink. */
        html { background: #fff; }
        a { color: var(--ink); text-decoration: none; }
      }
    </style>

    <script>
      // Theme toggle: the boot script in <head> has already set data-theme
      // before paint; this wires the button, persists the choice, and keeps
      // the browser-chrome color and button state in sync.
      const toggle = document.getElementById('theme-toggle');
      const themeColor = document.querySelector('meta[name="theme-color"]');
      // The button is labeled with the action it performs, so the visible text
      // is the accessible name; no aria-pressed alongside a changing label.
      const reflect = (t: string) => {
        document.documentElement.dataset.theme = t;
        themeColor?.setAttribute('content', t === 'dark' ? '#211e18' : '#f5efe4');
        if (toggle) toggle.textContent = t === 'dark' ? '◑ Light mode' : '◐ Dark mode';
      };
      reflect(document.documentElement.dataset.theme ?? 'light');
      toggle?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        try { localStorage.setItem('theme', next); } catch {}
        reflect(next);
      });
    </script>
  </body>
</html>