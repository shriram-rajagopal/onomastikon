---
interface Props {
  title: string;
  description?: string;
  image?: string;
}
const { title, description, image } = Astro.props;

// Public-facing text is authored, never synthesized here: the description is an
// entity's own summary (passed in) or the site tagline. The OG image is the
// page's title card when it has one, otherwise the site-wide fallback card.
const metaDescription = description ?? 'A digital atlas of ancient names.';
const pageTitle = `${title} — Onomastikon`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL(image ?? '/og-default.png', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <meta name="theme-color" content="#f5efe4" />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Twitter social previews. Description mirrors the page's
         authored summary; image is the entity title card or the fallback. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Onomastikon" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="720" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,600;1,400&family=Inter:wght@400;600&family=Noto+Sans+Egyptian+Hieroglyphs&family=Noto+Sans+Old+Persian&family=Noto+Sans+Cuneiform&family=Noto+Serif+Devanagari&family=Noto+Serif+Hebrew&family=Noto+Naskh+Arabic&family=Noto+Sans+Coptic&family=Noto+Sans+Ethiopic&family=Noto+Sans+Inscriptional+Pahlavi&family=Noto+Sans+Inscriptional+Parthian&family=Noto+Sans+Manichaean&family=Noto+Sans+Syriac&family=Noto+Sans+Phoenician&family=Noto+Sans+Ugaritic&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a href="/" class="logo">Onomastikon</a>
      <nav>
        <a href="/search">Search</a>
        <a href="/about">About</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>Onomastikon · A digital atlas of ancient names</p>
    </footer>

    <style is:global>
      :root {
        --parchment: #f5efe4;
        --ink: #1a1a1a;
        --ink-soft: #4a4a4a;
        --rule: #d8cfbf;
        --accent: #6b3a2a;
        --max-width: 720px;
      }
      * { box-sizing: border-box; }
      html { background: var(--parchment); color: var(--ink); scroll-behavior: smooth; }
      /* Keyboard focus: a consistent, clearly visible ring in the accent color.
         :focus-visible keeps it off mouse clicks. */
      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }
      /* Skip link: visually hidden until focused, then pinned at the top. */
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 10;
        padding: 0.5rem 1rem;
        background: var(--parchment);
        color: var(--accent);
        font-family: 'Inter', sans-serif;
        font-size: 0.875rem;
        border: 1px solid var(--rule);
      }
      .skip-link:focus {
        left: 1rem;
      }
      /* Honor reduced-motion: jump instantly to hash anchors instead of animating. */
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
      }
      body {
        margin: 0;
        font-family: 'EB Garamond', Georgia, serif;
        font-size: 1.125rem;
        line-height: 1.6;
      }
      .site-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 2rem 1.5rem 1rem;
        border-bottom: 1px solid var(--rule);
      }
      .logo {
        font-size: 1.5rem;
        font-weight: 600;
        text-decoration: none;
        color: var(--ink);
        letter-spacing: 0.02em;
      }
      .site-header nav { font-family: 'Inter', sans-serif; font-size: 0.875rem; }
      .site-header nav a {
        margin-left: 1.5rem;
        text-decoration: none;
        color: var(--ink-soft);
      }
      .site-header nav a:hover { color: var(--accent); }
      main {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 2rem 1.5rem 4rem;
      }
      .site-footer {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 2rem 1.5rem;
        border-top: 1px solid var(--rule);
        font-family: 'Inter', sans-serif;
        font-size: 0.8125rem;
        color: var(--ink-soft);
      }
      h1, h2, h3 { font-weight: 600; letter-spacing: -0.01em; }
      h1 { font-size: 2.5rem; margin: 0 0 0.25rem; }
      h2 { font-size: 1.5rem; margin: 2.5rem 0 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--rule); }
      a { color: var(--accent); }
      @media print {
        .skip-link, .site-header nav { display: none; }
        /* Most browsers omit backgrounds when printing; keep text plain ink. */
        html { background: #fff; }
        a { color: var(--ink); text-decoration: none; }
      }
    </style>
  </body>
</html>